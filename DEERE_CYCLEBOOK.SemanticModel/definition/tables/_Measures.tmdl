	/// The Stack: FINANCIALS finding, year-to-date sales and net income against a year earlier, then the peak and guidance.
	measure 'SVG Financials Finding' =
			VAR _k = [Latest Period Key]
			VAR _fy = INT(_k / 100)
			VAR _q = MOD(_k, 100)
			VAR _ni = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _niP = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 1, 'Quarterly Financials'[Period Key] <= _k - 100)
			VAR _rev = CALCULATE(SUM('Quarterly Financials'[Net Sales & Revenues]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _revP = CALCULATE(SUM('Quarterly Financials'[Net Sales & Revenues]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 1, 'Quarterly Financials'[Period Key] <= _k - 100)
			VAR _eps = CALCULATE(SUM('Quarterly Financials'[Diluted EPS]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _peak = CALCULATE(MAX('Annual Financials'[Net Income]), REMOVEFILTERS('Annual Financials'))
			VAR _peakYr = CALCULATE(MAX('Annual Financials'[Fiscal Year]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Net Income] = _peak)
			VAR _lastYr = CALCULATE(MAX('Annual Financials'[Fiscal Year]), REMOVEFILTERS('Annual Financials'))
			VAR _lastNi = CALCULATE(SUM('Annual Financials'[Net Income]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _lastYr)
			VAR _lastEps = CALCULATE(SUM('Annual Financials'[Diluted EPS]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _lastYr)
			VAR _peakEps = CALCULATE(SUM('Annual Financials'[Diluted EPS]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _peakYr)
			VAR _lastQ4 = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Period Key] = _lastYr * 100 + 4)
			VAR _gLo = 4750
			VAR _gHi = 5000
			VAR _thru = "FY" & _fy & " through Q" & _q
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='84' viewBox='0 0 1420 84' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & "<text x='0' y='30' font-size='24' font-weight='bold' fill='%230E0E0C'>" & "Deere sold " & SUBSTITUTE(FORMAT(ABS(DIVIDE(_rev, _revP) - 1), "0%"), "%", "%25") & IF(DIVIDE(_rev, _revP) - 1 >= 0, " more", " less") & " through Q" & _q & " of fiscal " & _fy & " than a year ago, and earned " & SUBSTITUTE(FORMAT(ABS(DIVIDE(_ni, _niP) - 1), "0%"), "%", "%25") & IF(DIVIDE(_ni, _niP) - 1 >= 0, " more", " less") & "." & "</text>"
			        & "<text x='0' y='70' font-size='22' fill='%230E0E0C'>" & "Net income peaked at " & FORMAT(_peak / 1000, "$0.00") & "B in FY" & _peakYr & ". Management expects $4.75B-5.00B this year, " & IF(_gHi < _lastNi, "under", IF(_gLo > _lastNi, "above", "around")) & " FY" & _lastYr & "'s " & FORMAT(_lastNi / 1000, "$0.00") & "B." & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: c90974e9-1a5f-4709-b50f-8c476a1a1e6b

	/// The Stack: net income by fiscal year with the current year to date, what Q4 still needs, and the guidance range.
	measure 'SVG Financials Exhibit' =
			VAR _k = [Latest Period Key]
			VAR _fy = INT(_k / 100)
			VAR _q = MOD(_k, 100)
			VAR _ni = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _niP = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 1, 'Quarterly Financials'[Period Key] <= _k - 100)
			VAR _rev = CALCULATE(SUM('Quarterly Financials'[Net Sales & Revenues]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _revP = CALCULATE(SUM('Quarterly Financials'[Net Sales & Revenues]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 1, 'Quarterly Financials'[Period Key] <= _k - 100)
			VAR _eps = CALCULATE(SUM('Quarterly Financials'[Diluted EPS]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _peak = CALCULATE(MAX('Annual Financials'[Net Income]), REMOVEFILTERS('Annual Financials'))
			VAR _peakYr = CALCULATE(MAX('Annual Financials'[Fiscal Year]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Net Income] = _peak)
			VAR _lastYr = CALCULATE(MAX('Annual Financials'[Fiscal Year]), REMOVEFILTERS('Annual Financials'))
			VAR _lastNi = CALCULATE(SUM('Annual Financials'[Net Income]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _lastYr)
			VAR _lastEps = CALCULATE(SUM('Annual Financials'[Diluted EPS]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _lastYr)
			VAR _peakEps = CALCULATE(SUM('Annual Financials'[Diluted EPS]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _peakYr)
			VAR _lastQ4 = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Period Key] = _lastYr * 100 + 4)
			VAR _gLo = 4750
			VAR _gHi = 5000
			VAR _thru = "FY" & _fy & " through Q" & _q
			VAR _y0 = MINX(ALL('Annual Financials'), 'Annual Financials'[Fiscal Year])
			VAR _cx = 153 + (_fy - _y0) * 166
			VAR _top = ROUND(470 - (_ni) / 1000 * 36.36, 1)
			VAR _gTop = ROUND(470 - (_gHi) / 1000 * 36.36, 1)
			VAR _gBot = ROUND(470 - (_gLo) / 1000 * 36.36, 1)
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='960' height='620' viewBox='0 0 960 620' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><text x='0' y='22' font-size='16' font-weight='bold' fill='%230E0E0C'>Net income by fiscal year, against FY2026 guidance</text><g font-size='13' fill='%230E0E0C'><rect x='0' y='35' width='14' height='14' fill='%230E0E0C'/><text x='22' y='47'>Reported</text><rect x='120' y='36' width='13' height='13' fill='none' stroke='%230E0E0C' stroke-width='2' stroke-dasharray='4 3'/><text x='142' y='47'>What Q4 needs to hit guidance</text><rect x='430' y='35' width='14' height='14' fill='%23367C2B'/><text x='452' y='47'>Management guidance</text></g><line x1='70' y1='397.28' x2='900' y2='397.28' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='402.28' text-anchor='end' font-size='13' fill='%230E0E0C'>$2B</text><line x1='70' y1='324.56' x2='900' y2='324.56' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='329.56' text-anchor='end' font-size='13' fill='%230E0E0C'>$4B</text><line x1='70' y1='251.84' x2='900' y2='251.84' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='256.84000000000003' text-anchor='end' font-size='13' fill='%230E0E0C'>$6B</text><line x1='70' y1='179.12' x2='900' y2='179.12' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='184.12' text-anchor='end' font-size='13' fill='%230E0E0C'>$8B</text><line x1='70' y1='106.39999999999998' x2='900' y2='106.39999999999998' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='111.39999999999998' text-anchor='end' font-size='13' fill='%230E0E0C'>$10B</text><rect x='70' y='469' width='830' height='3' fill='%230E0E0C'/><rect x='0' y='508' width='960' height='3' fill='%230E0E0C'/><rect x='0' y='546' width='960' height='1' fill='%230E0E0C'/><rect x='0' y='580' width='960' height='2' fill='%230E0E0C'/><g font-size='14' font-weight='bold' fill='%230E0E0C'><text x='0' y='533'>Sales</text><text x='0' y='569'>EPS</text></g>"
			        & CONCATENATEX(ALL('Annual Financials'),
			            VAR _x = 153 + ('Annual Financials'[Fiscal Year] - _y0) * 166
			            VAR _t = ROUND(470 - ('Annual Financials'[Net Income]) / 1000 * 36.36, 1)
			            RETURN
			                "<rect x='" & (_x - 50) & "' y='" & _t & "' width='100' height='" & (470 - _t) & "' fill='%230E0E0C'/>"
			                & "<text x='" & _x & "' y='" & (_t - 10) & "' text-anchor='middle' font-size='15' font-weight='bold' fill='%230E0E0C'>" & FORMAT('Annual Financials'[Net Income] / 1000, "$0.00") & "B</text>"
			                & "<text x='" & _x & "' y='496' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>FY" & 'Annual Financials'[Fiscal Year] & "</text>"
			                & "<text x='" & _x & "' y='533' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & FORMAT('Annual Financials'[Net Sales & Revenues] / 1000, "$0.0") & "B</text>"
			                & "<text x='" & _x & "' y='569' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & FORMAT('Annual Financials'[Diluted EPS], "$0.00") & "</text>",
			            "", 'Annual Financials'[Fiscal Year], ASC)
			        & "<rect x='" & (_cx - 50) & "' y='" & _top & "' width='100' height='" & (470 - _top) & "' fill='%230E0E0C'/>"
			        & "<text x='" & _cx & "' y='" & (_top + 24) & "' text-anchor='middle' font-size='15' font-weight='bold' fill='%23F4F4F0'>" & FORMAT(_ni / 1000, "$0.00") & "B</text>"
			        & "<text x='" & _cx & "' y='" & (_top + 42) & "' text-anchor='middle' font-size='12' fill='%23F4F4F0'>to Q" & _q & "</text>"
			        & "<rect x='" & (_cx - 49) & "' y='" & _gBot & "' width='98' height='" & (_top - _gBot) & "' fill='none' stroke='%230E0E0C' stroke-width='2' stroke-dasharray='6 4'/>"
			        & "<rect x='" & (_cx - 50) & "' y='" & _gTop & "' width='100' height='" & (_gBot - _gTop) & "' fill='%23367C2B'/>"
			        & "<rect x='" & (_cx - 90) & "' y='" & (_gTop - 46) & "' width='180' height='40' fill='%23F4F4F0'/>"
			        & "<text x='" & _cx & "' y='" & (_gTop - 30) & "' text-anchor='middle' font-size='13' font-weight='bold' fill='%23367C2B'>Guidance $4.75B-5.00B</text>"
			        & "<text x='" & _cx & "' y='" & (_gTop - 12) & "' text-anchor='middle' font-size='13' fill='%230E0E0C'>Q4 needs " & FORMAT((_gLo - _ni) / 1000, "$0.00") & "B-" & FORMAT((_gHi - _ni) / 1000, "0.00") & "B</text>"
			        & "<text x='" & _cx & "' y='496' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>FY" & _fy & "</text>"
			        & "<text x='" & _cx & "' y='533' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & FORMAT(_rev / 1000, "$0.0") & "B to Q" & _q & "</text>"
			        & "<text x='" & _cx & "' y='569' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & FORMAT(_eps, "$0.00") & " to Q" & _q & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 99db969e-944f-4828-a343-7d920770e5ee

	/// The Stack: FINANCIALS ledger of year-to-date actuals, prior years and guidance.
	measure 'SVG Financials Ledger' =
			VAR _k = [Latest Period Key]
			VAR _fy = INT(_k / 100)
			VAR _q = MOD(_k, 100)
			VAR _ni = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _niP = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 1, 'Quarterly Financials'[Period Key] <= _k - 100)
			VAR _rev = CALCULATE(SUM('Quarterly Financials'[Net Sales & Revenues]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _revP = CALCULATE(SUM('Quarterly Financials'[Net Sales & Revenues]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 1, 'Quarterly Financials'[Period Key] <= _k - 100)
			VAR _eps = CALCULATE(SUM('Quarterly Financials'[Diluted EPS]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Fiscal Year] = _fy - 0, 'Quarterly Financials'[Period Key] <= _k - 0)
			VAR _peak = CALCULATE(MAX('Annual Financials'[Net Income]), REMOVEFILTERS('Annual Financials'))
			VAR _peakYr = CALCULATE(MAX('Annual Financials'[Fiscal Year]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Net Income] = _peak)
			VAR _lastYr = CALCULATE(MAX('Annual Financials'[Fiscal Year]), REMOVEFILTERS('Annual Financials'))
			VAR _lastNi = CALCULATE(SUM('Annual Financials'[Net Income]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _lastYr)
			VAR _lastEps = CALCULATE(SUM('Annual Financials'[Diluted EPS]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _lastYr)
			VAR _peakEps = CALCULATE(SUM('Annual Financials'[Diluted EPS]), REMOVEFILTERS('Annual Financials'), 'Annual Financials'[Fiscal Year] = _peakYr)
			VAR _lastQ4 = CALCULATE(SUM('Quarterly Financials'[Net Income]), REMOVEFILTERS('Quarterly Financials'), REMOVEFILTERS('Period'), 'Quarterly Financials'[Period Key] = _lastYr * 100 + 4)
			VAR _gLo = 4750
			VAR _gHi = 5000
			VAR _thru = "FY" & _fy & " through Q" & _q
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='440' height='572' viewBox='0 0 440 572' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & "<rect x='0' y='0' width='440' height='3' fill='%230E0E0C'/><rect x='0' y='38' width='54' height='16' fill='%230E0E0C'/><text x='27' y='50' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='26' font-size='15' font-weight='bold' fill='%230E0E0C'>" & "Net income, " & _thru & "</text>"
			        & "<text x='62' y='51' font-size='13' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_ni, _niP) - 1, "+0%;-0%;0%"), "%", "%25") & " vs the same quarters of FY" & (_fy - 1) & "</text>"
			        & "<g fill='%230E0E0C'>" & (
			        VAR _ptfl0 = "$" & FORMAT(_ni, "#,##0") & "M"
			        VAR _pxfl0 = (440 - (LEN("$" & FORMAT(_ni, "#,##0") & "M") * 30 - 5))
			        VAR _pyfl0 = 66
			        RETURN
			            CONCATENATEX(
			                GENERATE(
			                    SELECTCOLUMNS(GENERATESERIES(1, LEN(_ptfl0), 1), "cifl0", [Value]),
			                    VAR _bits = LOOKUPVALUE('Glyphs'[Bits], 'Glyphs'[Code], UNICODE(MID(_ptfl0, [cifl0], 1)), REPT("0", 35))
			                    RETURN FILTER(SELECTCOLUMNS(GENERATESERIES(0, 34, 1), "cellfl0", [Value]), MID(_bits, [cellfl0] + 1, 1) = "1")
			                ),
			                "<rect x='" & (_pxfl0 + ([cifl0] - 1) * 30 + MOD([cellfl0], 5) * 5) & "' y='" & (_pyfl0 + INT([cellfl0] / 5) * 5) & "' width='5' height='5'/>",
			                ""
			            )
			    ) & "</g>"
			        & "<rect x='0' y='112' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='146' width='54' height='16' fill='%230E0E0C'/><text x='27' y='158' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='136' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net sales, " & _thru & "</text>"
			        & "<text x='62' y='159' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_rev, _revP) - 1, "+0%;-0%;0%"), "%", "%25") & " vs a year earlier" & "</text>"
			        & "<text x='440' y='157' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_rev, "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='188' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='222' width='54' height='16' fill='%230E0E0C'/><text x='27' y='234' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='212' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net margin, " & _thru & "</text>"
			        & "<text x='62' y='235' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_niP, _revP), "0.0%"), "%", "%25") & " a year earlier" & "</text>"
			        & "<text x='440' y='233' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_ni, _rev), "0.0%"), "%", "%25") & "</text>"
			        & "<rect x='0' y='264' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='298' width='54' height='16' fill='%230E0E0C'/><text x='27' y='310' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='288' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net income, FY" & _lastYr & "</text>"
			        & "<text x='62' y='311' font-size='12' fill='%230E0E0C'>" & "Diluted EPS " & FORMAT(_lastEps, "$0.00") & "</text>"
			        & "<text x='440' y='309' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_lastNi, "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='340' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='374' width='54' height='16' fill='%230E0E0C'/><text x='27' y='386' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='364' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net income, FY" & _peakYr & " record" & "</text>"
			        & "<text x='62' y='387' font-size='12' fill='%230E0E0C'>" & "Diluted EPS " & FORMAT(_peakEps, "$0.00") & "</text>"
			        & "<text x='440' y='385' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_peak, "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='416' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='450' width='72' height='16' fill='%23367C2B'/><text x='36' y='462' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='440' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net income guidance, FY" & _fy & "</text>"
			        & "<text x='80' y='463' font-size='12' fill='%230E0E0C'>" & "Management's range" & "</text>"
			        & "<text x='440' y='461' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "$4.75B-5.00B" & "</text>"
			        & "<rect x='0' y='492' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='526' width='72' height='16' fill='%23367C2B'/><text x='36' y='538' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='516' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Q4 needed to hit guidance" & "</text>"
			        & "<text x='80' y='539' font-size='12' fill='%230E0E0C'>" & "Q4 FY" & _lastYr & ": $" & FORMAT(_lastQ4, "#,##0") & "M" & "</text>"
			        & "<text x='440' y='537' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "$" & FORMAT(_gLo - _ni, "#,##0") & "M-" & FORMAT(_gHi - _ni, "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='569' width='440' height='2' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: a1baf714-1981-41bd-b48f-cea8162e2b5a

	/// The Stack: SEGMENTS card header.
	measure 'SVG Header SEGMENTS' =
			VAR _price = [Latest Price]
			VAR _date = [Latest Price Date]
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='96' viewBox='0 0 1420 96' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><g fill='%230E0E0C'><rect x='10' y='8' width='10' height='10'/><rect x='20' y='8' width='10' height='10'/><rect x='30' y='8' width='10' height='10'/><rect x='40' y='8' width='10' height='10'/><rect x='0' y='18' width='10' height='10'/><rect x='0' y='28' width='10' height='10'/><rect x='10' y='38' width='10' height='10'/><rect x='20' y='38' width='10' height='10'/><rect x='30' y='38' width='10' height='10'/><rect x='40' y='48' width='10' height='10'/><rect x='40' y='58' width='10' height='10'/><rect x='0' y='68' width='10' height='10'/><rect x='10' y='68' width='10' height='10'/><rect x='20' y='68' width='10' height='10'/><rect x='30' y='68' width='10' height='10'/><rect x='60' y='8' width='10' height='10'/><rect x='70' y='8' width='10' height='10'/><rect x='80' y='8' width='10' height='10'/><rect x='90' y='8' width='10' height='10'/><rect x='100' y='8' width='10' height='10'/><rect x='60' y='18' width='10' height='10'/><rect x='60' y='28' width='10' height='10'/><rect x='60' y='38' width='10' height='10'/><rect x='70' y='38' width='10' height='10'/><rect x='80' y='38' width='10' height='10'/><rect x='90' y='38' width='10' height='10'/><rect x='60' y='48' width='10' height='10'/><rect x='60' y='58' width='10' height='10'/><rect x='60' y='68' width='10' height='10'/><rect x='70' y='68' width='10' height='10'/><rect x='80' y='68' width='10' height='10'/><rect x='90' y='68' width='10' height='10'/><rect x='100' y='68' width='10' height='10'/><rect x='130' y='8' width='10' height='10'/><rect x='140' y='8' width='10' height='10'/><rect x='150' y='8' width='10' height='10'/><rect x='120' y='18' width='10' height='10'/><rect x='160' y='18' width='10' height='10'/><rect x='120' y='28' width='10' height='10'/><rect x='120' y='38' width='10' height='10'/><rect x='140' y='38' width='10' height='10'/><rect x='150' y='38' width='10' height='10'/><rect x='160' y='38' width='10' height='10'/><rect x='120' y='48' width='10' height='10'/><rect x='160' y='48' width='10' height='10'/><rect x='120' y='58' width='10' height='10'/><rect x='160' y='58' width='10' height='10'/><rect x='130' y='68' width='10' height='10'/><rect x='140' y='68' width='10' height='10'/><rect x='150' y='68' width='10' height='10'/><rect x='160' y='68' width='10' height='10'/><rect x='180' y='8' width='10' height='10'/><rect x='220' y='8' width='10' height='10'/><rect x='180' y='18' width='10' height='10'/><rect x='190' y='18' width='10' height='10'/><rect x='210' y='18' width='10' height='10'/><rect x='220' y='18' width='10' height='10'/><rect x='180' y='28' width='10' height='10'/><rect x='200' y='28' width='10' height='10'/><rect x='220' y='28' width='10' height='10'/><rect x='180' y='38' width='10' height='10'/><rect x='200' y='38' width='10' height='10'/><rect x='220' y='38' width='10' height='10'/><rect x='180' y='48' width='10' height='10'/><rect x='220' y='48' width='10' height='10'/><rect x='180' y='58' width='10' height='10'/><rect x='220' y='58' width='10' height='10'/><rect x='180' y='68' width='10' height='10'/><rect x='220' y='68' width='10' height='10'/><rect x='240' y='8' width='10' height='10'/><rect x='250' y='8' width='10' height='10'/><rect x='260' y='8' width='10' height='10'/><rect x='270' y='8' width='10' height='10'/><rect x='280' y='8' width='10' height='10'/><rect x='240' y='18' width='10' height='10'/><rect x='240' y='28' width='10' height='10'/><rect x='240' y='38' width='10' height='10'/><rect x='250' y='38' width='10' height='10'/><rect x='260' y='38' width='10' height='10'/><rect x='270' y='38' width='10' height='10'/><rect x='240' y='48' width='10' height='10'/><rect x='240' y='58' width='10' height='10'/><rect x='240' y='68' width='10' height='10'/><rect x='250' y='68' width='10' height='10'/><rect x='260' y='68' width='10' height='10'/><rect x='270' y='68' width='10' height='10'/><rect x='280' y='68' width='10' height='10'/><rect x='300' y='8' width='10' height='10'/><rect x='340' y='8' width='10' height='10'/><rect x='300' y='18' width='10' height='10'/><rect x='340' y='18' width='10' height='10'/><rect x='300' y='28' width='10' height='10'/><rect x='310' y='28' width='10' height='10'/><rect x='340' y='28' width='10' height='10'/><rect x='300' y='38' width='10' height='10'/><rect x='320' y='38' width='10' height='10'/><rect x='340' y='38' width='10' height='10'/><rect x='300' y='48' width='10' height='10'/><rect x='330' y='48' width='10' height='10'/><rect x='340' y='48' width='10' height='10'/><rect x='300' y='58' width='10' height='10'/><rect x='340' y='58' width='10' height='10'/><rect x='300' y='68' width='10' height='10'/><rect x='340' y='68' width='10' height='10'/><rect x='360' y='8' width='10' height='10'/><rect x='370' y='8' width='10' height='10'/><rect x='380' y='8' width='10' height='10'/><rect x='390' y='8' width='10' height='10'/><rect x='400' y='8' width='10' height='10'/><rect x='380' y='18' width='10' height='10'/><rect x='380' y='28' width='10' height='10'/><rect x='380' y='38' width='10' height='10'/><rect x='380' y='48' width='10' height='10'/><rect x='380' y='58' width='10' height='10'/><rect x='380' y='68' width='10' height='10'/><rect x='430' y='8' width='10' height='10'/><rect x='440' y='8' width='10' height='10'/><rect x='450' y='8' width='10' height='10'/><rect x='460' y='8' width='10' height='10'/><rect x='420' y='18' width='10' height='10'/><rect x='420' y='28' width='10' height='10'/><rect x='430' y='38' width='10' height='10'/><rect x='440' y='38' width='10' height='10'/><rect x='450' y='38' width='10' height='10'/><rect x='460' y='48' width='10' height='10'/><rect x='460' y='58' width='10' height='10'/><rect x='420' y='68' width='10' height='10'/><rect x='430' y='68' width='10' height='10'/><rect x='440' y='68' width='10' height='10'/><rect x='450' y='68' width='10' height='10'/></g>"
			        & "<text x='1420' y='36' text-anchor='end' font-size='16' font-weight='bold' fill='%230E0E0C'>Deere &amp; Company &%23183; NYSE: DE</text>"
			        & "<text x='1420' y='62' text-anchor='end' font-size='15' fill='%230E0E0C'>Close " & FORMAT(_price, "$#,##0.00") & " on " & FORMAT(_date, "d mmm yyyy") & " &%23183; reported through " & [Latest Period Label] & "</text>"
			        & "<rect x='0' y='86' width='1420' height='4' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: eda2761e-4aa6-4f99-8eca-3ce745c81060

	/// The Stack: SEGMENTS finding, which segment earns more this fiscal year, then year-to-date profit against the peak-year mix.
	measure 'SVG Segments Finding' =
			VAR _k = [Latest Period Key]
			VAR _fy = INT(_k / 100)
			VAR _q = MOD(_k, 100)
			VAR _ppa = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 1)
			VAR _sat = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 2)
			VAR _cf = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 3)
			VAR _prior = CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "PPA", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100) + CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "SAT", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100) + CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "CF", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100)
			VAR _quarters = FILTER(ALL('Period'[Period Key]), 'Period'[Period Key] > _fy * 100 && 'Period'[Period Key] <= _k)
			VAR _satAhead = COUNTROWS(FILTER(_quarters, LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT") > LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA")))
			VAR _prev = FILTER(ALL('Period'[Period Key]), 'Period'[Period Key] > (_fy - 2) * 100 && 'Period'[Period Key] < _fy * 100)
			VAR _nPrev = COUNTROWS(_prev)
			VAR _ppaAhead = COUNTROWS(FILTER(_prev, LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA") > LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT")))
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='84' viewBox='0 0 1420 84' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & "<text x='0' y='30' font-size='24' font-weight='bold' fill='%230E0E0C'>" & IF(_satAhead = _q, "Small ag and turf has earned more than large ag in " & SWITCH(_q, 1, "the first quarter", 2, "both quarters", 3, "all three quarters", "all four quarters") & " of fiscal " & _fy & ".", "Small ag and turf earned more than large ag in " & _satAhead & " of " & _q & " quarters of fiscal " & _fy & ".") & "</text>"
			        & "<text x='0' y='70' font-size='22' fill='%230E0E0C'>" & "Large ag led " & IF(_ppaAhead = _nPrev, "all " & _nPrev, _ppaAhead & " of " & _nPrev) & " quarters of FY" & (_fy - 2) & "-" & RIGHT(_fy - 1, 2) & ". Through Q" & _q & " this year, " & IF(_sat >= _ppa, "small ag leads $" & FORMAT(_sat, "#,##0") & "M to $" & FORMAT(_ppa, "#,##0"), "large ag leads $" & FORMAT(_ppa, "#,##0") & "M to $" & FORMAT(_sat, "#,##0")) & "M." & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: f5ce2075-487d-4e88-ad22-8b28c7e04db6

	/// The Stack: segment operating profit by quarter over the last eleven quarters.
	measure 'SVG Segments Exhibit' =
			VAR _k = [Latest Period Key]
			VAR _fy = INT(_k / 100)
			VAR _q = MOD(_k, 100)
			VAR _ppa = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 1)
			VAR _sat = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 2)
			VAR _cf = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 3)
			VAR _prior = CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "PPA", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100) + CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "SAT", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100) + CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "CF", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100)
			VAR _quarters = FILTER(ALL('Period'[Period Key]), 'Period'[Period Key] > _fy * 100 && 'Period'[Period Key] <= _k)
			VAR _satAhead = COUNTROWS(FILTER(_quarters, LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT") > LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA")))
			VAR _prev = FILTER(ALL('Period'[Period Key]), 'Period'[Period Key] > (_fy - 2) * 100 && 'Period'[Period Key] < _fy * 100)
			VAR _nPrev = COUNTROWS(_prev)
			VAR _ppaAhead = COUNTROWS(FILTER(_prev, LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA") > LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT")))
			VAR _last = TOPN(11, ALL('Period'[Period Key], 'Period'[Period Sort], 'Period'[Fiscal Year], 'Period'[Fiscal Quarter]), 'Period'[Period Sort], DESC)
			VAR _minSort = MINX(_last, 'Period'[Period Sort])
			VAR _pts = ADDCOLUMNS(_last, "@x", 70 + ('Period'[Period Sort] - _minSort) * 75)
			VAR _x0 = MINX(FILTER(_pts, 'Period'[Fiscal Year] = _fy), [@x])
			VAR _vPPA = LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], _k, 'Quarterly Segments'[Segment Code], "PPA")
			VAR _vSAT = LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], _k, 'Quarterly Segments'[Segment Code], "SAT")
			VAR _vCF = LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], _k, 'Quarterly Segments'[Segment Code], "CF")
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='960' height='620' viewBox='0 0 960 620' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><text x='0' y='22' font-size='16' font-weight='bold' fill='%230E0E0C'>Segment operating profit by quarter</text><g fill='none' stroke='%230E0E0C'><line x1='0' y1='44' x2='34' y2='44' stroke-width='5'/><line x1='270' y1='44' x2='304' y2='44' stroke-width='3' stroke-dasharray='14 7'/><line x1='510' y1='44' x2='544' y2='44' stroke-width='3' stroke-dasharray='4 6'/></g><g font-size='13' fill='%230E0E0C'><text x='42' y='49'>PPA Production &amp; Precision Ag</text><text x='312' y='49'>SAT Small Ag &amp; Turf</text><text x='552' y='49'>C&amp;F Construction &amp; Forestry</text></g><line x1='70' y1='396.1' x2='820' y2='396.1' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='401.1' text-anchor='end' font-size='13' fill='%230E0E0C'>$0.5B</text><line x1='70' y1='282.2' x2='820' y2='282.2' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='287.2' text-anchor='end' font-size='13' fill='%230E0E0C'>$1.0B</text><line x1='70' y1='168.3' x2='820' y2='168.3' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='173.3' text-anchor='end' font-size='13' fill='%230E0E0C'>$1.5B</text><rect x='70' y='509' width='750' height='3' fill='%230E0E0C'/><text x='60' y='515' text-anchor='end' font-size='13' fill='%230E0E0C'>$0</text>"
			        & "<polyline fill='none' stroke='%230E0E0C' stroke-width='5' points='" & CONCATENATEX(_pts, [@x] & "," & ROUND(MAX(100, MIN(510, 510 - (LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA")) * 0.2278)), 1), " ", [@x], ASC) & "'/>"
			        & CONCATENATEX(_pts, "<rect x='" & ([@x] - 4) & "' y='" & (ROUND(MAX(100, MIN(510, 510 - (LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA")) * 0.2278)), 1) - 4) & "' width='8' height='8' fill='%230E0E0C'/>", "")
			        & "<text x='834' y='" & (ROUND(MAX(100, MIN(510, 510 - (_vPPA) * 0.2278)), 1) + 5) & "' font-size='15' font-weight='bold' fill='%230E0E0C'>PPA $" & FORMAT(_vPPA, "#,##0") & "M</text>"
			        & "<polyline fill='none' stroke='%230E0E0C' stroke-width='3' stroke-dasharray='14 7' points='" & CONCATENATEX(_pts, [@x] & "," & ROUND(MAX(100, MIN(510, 510 - (LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT")) * 0.2278)), 1), " ", [@x], ASC) & "'/>"
			        & CONCATENATEX(_pts, "<rect x='" & ([@x] - 4) & "' y='" & (ROUND(MAX(100, MIN(510, 510 - (LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT")) * 0.2278)), 1) - 4) & "' width='8' height='8' fill='%230E0E0C'/>", "")
			        & "<text x='834' y='" & (ROUND(MAX(100, MIN(510, 510 - (_vSAT) * 0.2278)), 1) + 5) & "' font-size='15' font-weight='bold' fill='%230E0E0C'>SAT $" & FORMAT(_vSAT, "#,##0") & "M</text>"
			        & "<polyline fill='none' stroke='%230E0E0C' stroke-width='3' stroke-dasharray='4 6' points='" & CONCATENATEX(_pts, [@x] & "," & ROUND(MAX(100, MIN(510, 510 - (LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "CF")) * 0.2278)), 1), " ", [@x], ASC) & "'/>"
			        & CONCATENATEX(_pts, "<rect x='" & ([@x] - 4) & "' y='" & (ROUND(MAX(100, MIN(510, 510 - (LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "CF")) * 0.2278)), 1) - 4) & "' width='8' height='8' fill='%230E0E0C'/>", "")
			        & "<text x='834' y='" & (ROUND(MAX(100, MIN(510, 510 - (_vCF) * 0.2278)), 1) + 5) & "' font-size='15' font-weight='bold' fill='%230E0E0C'>C&amp;F $" & FORMAT(_vCF, "#,##0") & "M</text>"
			        & CONCATENATEX(FILTER(_pts, 'Period'[Fiscal Quarter] = "Q1" && [@x] > 70), "<line x1='" & ([@x] - 37.5) & "' y1='100' x2='" & ([@x] - 37.5) & "' y2='580' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/>", "")
			        & CONCATENATEX(_pts, "<text x='" & [@x] & "' y='536' text-anchor='middle' font-size='13' fill='%230E0E0C'>" & 'Period'[Fiscal Quarter] & "</text>", "", [@x], ASC)
			        & CONCATENATEX(DISTINCT(SELECTCOLUMNS(_pts, "@fy", 'Period'[Fiscal Year])), VAR _f = [@fy] RETURN "<text x='" & AVERAGEX(FILTER(_pts, 'Period'[Fiscal Year] = _f), [@x]) & "' y='562' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>FY" & _f & "</text>", "")
			        // FY2026 SAT and PPA values sit in two rows under the axis, off the line paths where the series cross.
			        & "<text x='" & (_x0 - 34) & "' y='592' text-anchor='end' font-size='12' font-weight='bold' fill='%230E0E0C'>SAT, $M</text><text x='" & (_x0 - 34) & "' y='610' text-anchor='end' font-size='12' font-weight='bold' fill='%230E0E0C'>PPA, $M</text>"
			        & CONCATENATEX(FILTER(_pts, 'Period'[Fiscal Year] = _fy),
			            "<text x='" & [@x] & "' y='592' text-anchor='middle' font-size='12' fill='%230E0E0C'>" & FORMAT(LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT"), "#,##0") & "</text>"
			                & "<text x='" & [@x] & "' y='610' text-anchor='middle' font-size='12' fill='%230E0E0C'>" & FORMAT(LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA"), "#,##0") & "</text>", "")
			        & IF(_satAhead = _q, "<rect x='" & (_x0 - 10) & "' y='76' width='" & (MAXX(_pts, [@x]) - _x0 + 20) & "' height='3' fill='%230E0E0C'/><rect x='" & (_x0 - 10) & "' y='76' width='3' height='12' fill='%230E0E0C'/><rect x='" & (MAXX(_pts, [@x]) + 7) & "' y='76' width='3' height='12' fill='%230E0E0C'/><text x='" & (MAXX(_pts, [@x]) + 10) & "' y='70' text-anchor='end' font-size='14' font-weight='bold' fill='%230E0E0C'>Small ag ahead all year</text>", "")
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 4c33508d-707b-4047-883d-7327f6e03c1b

	/// The Stack: SEGMENTS ledger of year-to-date segment profit and the FY2026 sales outlook.
	measure 'SVG Segments Ledger' =
			VAR _k = [Latest Period Key]
			VAR _fy = INT(_k / 100)
			VAR _q = MOD(_k, 100)
			VAR _ppa = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 1)
			VAR _sat = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 2)
			VAR _cf = CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 3)
			VAR _prior = CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "PPA", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100) + CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "SAT", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100) + CALCULATE(SUM('Quarterly Segments'[Operating Profit]), REMOVEFILTERS('Quarterly Segments'), REMOVEFILTERS('Period'), 'Quarterly Segments'[Segment Code] = "CF", 'Quarterly Segments'[Period Key] > (_fy - 1) * 100, 'Quarterly Segments'[Period Key] <= _k - 100)
			VAR _quarters = FILTER(ALL('Period'[Period Key]), 'Period'[Period Key] > _fy * 100 && 'Period'[Period Key] <= _k)
			VAR _satAhead = COUNTROWS(FILTER(_quarters, LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT") > LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA")))
			VAR _prev = FILTER(ALL('Period'[Period Key]), 'Period'[Period Key] > (_fy - 2) * 100 && 'Period'[Period Key] < _fy * 100)
			VAR _nPrev = COUNTROWS(_prev)
			VAR _ppaAhead = COUNTROWS(FILTER(_prev, LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA") > LOOKUPVALUE('Quarterly Segments'[Operating Profit], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT")))
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='440' height='572' viewBox='0 0 440 572' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & "<rect x='0' y='0' width='440' height='3' fill='%230E0E0C'/><rect x='0' y='38' width='54' height='16' fill='%230E0E0C'/><text x='27' y='50' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='26' font-size='15' font-weight='bold' fill='%230E0E0C'>" & "Equipment operating profit, FY" & _fy & " through Q" & _q & "</text>"
			        & "<text x='62' y='51' font-size='13' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_ppa + _sat + _cf, _prior) - 1, "+0%;-0%;0%"), "%", "%25") & " vs the same quarters of FY" & (_fy - 1) & "</text>"
			        & "<g fill='%230E0E0C'>" & (
			        VAR _ptsl0 = "$" & FORMAT(_ppa + _sat + _cf, "#,##0") & "M"
			        VAR _pxsl0 = (440 - (LEN("$" & FORMAT(_ppa + _sat + _cf, "#,##0") & "M") * 30 - 5))
			        VAR _pysl0 = 66
			        RETURN
			            CONCATENATEX(
			                GENERATE(
			                    SELECTCOLUMNS(GENERATESERIES(1, LEN(_ptsl0), 1), "cisl0", [Value]),
			                    VAR _bits = LOOKUPVALUE('Glyphs'[Bits], 'Glyphs'[Code], UNICODE(MID(_ptsl0, [cisl0], 1)), REPT("0", 35))
			                    RETURN FILTER(SELECTCOLUMNS(GENERATESERIES(0, 34, 1), "cellsl0", [Value]), MID(_bits, [cellsl0] + 1, 1) = "1")
			                ),
			                "<rect x='" & (_pxsl0 + ([cisl0] - 1) * 30 + MOD([cellsl0], 5) * 5) & "' y='" & (_pysl0 + INT([cellsl0] / 5) * 5) & "' width='5' height='5'/>",
			                ""
			            )
			    ) & "</g>"
			        & "<rect x='0' y='112' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='146' width='54' height='16' fill='%230E0E0C'/><text x='27' y='158' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='136' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "SAT operating profit, through Q" & _q & "</text>"
			        & "<text x='62' y='159' font-size='12' fill='%230E0E0C'>" & "Q" & _q & " margin " & SUBSTITUTE(FORMAT(LOOKUPVALUE('Quarterly Segments'[Operating Margin], 'Quarterly Segments'[Period Key], _k, 'Quarterly Segments'[Segment Code], "SAT"), "0.0%"), "%", "%25") & "</text>"
			        & "<text x='440' y='157' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_sat, "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='188' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='222' width='54' height='16' fill='%230E0E0C'/><text x='27' y='234' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='212' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "PPA operating profit, through Q" & _q & "</text>"
			        & "<text x='62' y='235' font-size='12' fill='%230E0E0C'>" & "Q" & _q & " margin " & SUBSTITUTE(FORMAT(LOOKUPVALUE('Quarterly Segments'[Operating Margin], 'Quarterly Segments'[Period Key], _k, 'Quarterly Segments'[Segment Code], "PPA"), "0.0%"), "%", "%25") & "</text>"
			        & "<text x='440' y='233' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_ppa, "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='264' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='298' width='54' height='16' fill='%230E0E0C'/><text x='27' y='310' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='288' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "C&amp;F operating profit, through Q" & _q & "</text>"
			        & "<text x='62' y='311' font-size='12' fill='%230E0E0C'>" & "Q" & _q & " margin " & SUBSTITUTE(FORMAT(LOOKUPVALUE('Quarterly Segments'[Operating Margin], 'Quarterly Segments'[Period Key], _k, 'Quarterly Segments'[Segment Code], "CF"), "0.0%"), "%", "%25") & "</text>"
			        & "<text x='440' y='309' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_cf, "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='340' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='374' width='72' height='16' fill='%23367C2B'/><text x='36' y='386' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='364' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "PPA net sales outlook, FY" & _fy & "</text>"
			        & "<text x='80' y='387' font-size='12' fill='%230E0E0C'>" & "Management, Q3 release" & "</text>"
			        & "<text x='440' y='385' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "About -10%25" & "</text>"
			        & "<rect x='0' y='416' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='450' width='72' height='16' fill='%23367C2B'/><text x='36' y='462' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='440' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "SAT net sales outlook, FY" & _fy & "</text>"
			        & "<text x='80' y='463' font-size='12' fill='%230E0E0C'>" & "Management, Q3 release" & "</text>"
			        & "<text x='440' y='461' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "About +15%25" & "</text>"
			        & "<rect x='0' y='492' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='526' width='72' height='16' fill='%23367C2B'/><text x='36' y='538' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='516' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "C&amp;F net sales outlook, FY" & _fy & "</text>"
			        & "<text x='80' y='539' font-size='12' fill='%230E0E0C'>" & "Management, Q3 release" & "</text>"
			        & "<text x='440' y='537' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "About +20%25" & "</text>"
			        & "<rect x='0' y='569' width='440' height='2' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 554b579f-ce9d-462a-8c43-bb43789e082c

	/// The Stack: THE CYCLE card header.
	measure 'SVG Header THE CYCLE' =
			VAR _price = [Latest Price]
			VAR _date = [Latest Price Date]
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='96' viewBox='0 0 1420 96' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><g fill='%230E0E0C'><rect x='0' y='8' width='10' height='10'/><rect x='10' y='8' width='10' height='10'/><rect x='20' y='8' width='10' height='10'/><rect x='30' y='8' width='10' height='10'/><rect x='40' y='8' width='10' height='10'/><rect x='20' y='18' width='10' height='10'/><rect x='20' y='28' width='10' height='10'/><rect x='20' y='38' width='10' height='10'/><rect x='20' y='48' width='10' height='10'/><rect x='20' y='58' width='10' height='10'/><rect x='20' y='68' width='10' height='10'/><rect x='60' y='8' width='10' height='10'/><rect x='100' y='8' width='10' height='10'/><rect x='60' y='18' width='10' height='10'/><rect x='100' y='18' width='10' height='10'/><rect x='60' y='28' width='10' height='10'/><rect x='100' y='28' width='10' height='10'/><rect x='60' y='38' width='10' height='10'/><rect x='70' y='38' width='10' height='10'/><rect x='80' y='38' width='10' height='10'/><rect x='90' y='38' width='10' height='10'/><rect x='100' y='38' width='10' height='10'/><rect x='60' y='48' width='10' height='10'/><rect x='100' y='48' width='10' height='10'/><rect x='60' y='58' width='10' height='10'/><rect x='100' y='58' width='10' height='10'/><rect x='60' y='68' width='10' height='10'/><rect x='100' y='68' width='10' height='10'/><rect x='120' y='8' width='10' height='10'/><rect x='130' y='8' width='10' height='10'/><rect x='140' y='8' width='10' height='10'/><rect x='150' y='8' width='10' height='10'/><rect x='160' y='8' width='10' height='10'/><rect x='120' y='18' width='10' height='10'/><rect x='120' y='28' width='10' height='10'/><rect x='120' y='38' width='10' height='10'/><rect x='130' y='38' width='10' height='10'/><rect x='140' y='38' width='10' height='10'/><rect x='150' y='38' width='10' height='10'/><rect x='120' y='48' width='10' height='10'/><rect x='120' y='58' width='10' height='10'/><rect x='120' y='68' width='10' height='10'/><rect x='130' y='68' width='10' height='10'/><rect x='140' y='68' width='10' height='10'/><rect x='150' y='68' width='10' height='10'/><rect x='160' y='68' width='10' height='10'/><rect x='250' y='8' width='10' height='10'/><rect x='260' y='8' width='10' height='10'/><rect x='270' y='8' width='10' height='10'/><rect x='240' y='18' width='10' height='10'/><rect x='280' y='18' width='10' height='10'/><rect x='240' y='28' width='10' height='10'/><rect x='240' y='38' width='10' height='10'/><rect x='240' y='48' width='10' height='10'/><rect x='240' y='58' width='10' height='10'/><rect x='280' y='58' width='10' height='10'/><rect x='250' y='68' width='10' height='10'/><rect x='260' y='68' width='10' height='10'/><rect x='270' y='68' width='10' height='10'/><rect x='300' y='8' width='10' height='10'/><rect x='340' y='8' width='10' height='10'/><rect x='300' y='18' width='10' height='10'/><rect x='340' y='18' width='10' height='10'/><rect x='300' y='28' width='10' height='10'/><rect x='340' y='28' width='10' height='10'/><rect x='310' y='38' width='10' height='10'/><rect x='330' y='38' width='10' height='10'/><rect x='320' y='48' width='10' height='10'/><rect x='320' y='58' width='10' height='10'/><rect x='320' y='68' width='10' height='10'/><rect x='370' y='8' width='10' height='10'/><rect x='380' y='8' width='10' height='10'/><rect x='390' y='8' width='10' height='10'/><rect x='360' y='18' width='10' height='10'/><rect x='400' y='18' width='10' height='10'/><rect x='360' y='28' width='10' height='10'/><rect x='360' y='38' width='10' height='10'/><rect x='360' y='48' width='10' height='10'/><rect x='360' y='58' width='10' height='10'/><rect x='400' y='58' width='10' height='10'/><rect x='370' y='68' width='10' height='10'/><rect x='380' y='68' width='10' height='10'/><rect x='390' y='68' width='10' height='10'/><rect x='420' y='8' width='10' height='10'/><rect x='420' y='18' width='10' height='10'/><rect x='420' y='28' width='10' height='10'/><rect x='420' y='38' width='10' height='10'/><rect x='420' y='48' width='10' height='10'/><rect x='420' y='58' width='10' height='10'/><rect x='420' y='68' width='10' height='10'/><rect x='430' y='68' width='10' height='10'/><rect x='440' y='68' width='10' height='10'/><rect x='450' y='68' width='10' height='10'/><rect x='460' y='68' width='10' height='10'/><rect x='480' y='8' width='10' height='10'/><rect x='490' y='8' width='10' height='10'/><rect x='500' y='8' width='10' height='10'/><rect x='510' y='8' width='10' height='10'/><rect x='520' y='8' width='10' height='10'/><rect x='480' y='18' width='10' height='10'/><rect x='480' y='28' width='10' height='10'/><rect x='480' y='38' width='10' height='10'/><rect x='490' y='38' width='10' height='10'/><rect x='500' y='38' width='10' height='10'/><rect x='510' y='38' width='10' height='10'/><rect x='480' y='48' width='10' height='10'/><rect x='480' y='58' width='10' height='10'/><rect x='480' y='68' width='10' height='10'/><rect x='490' y='68' width='10' height='10'/><rect x='500' y='68' width='10' height='10'/><rect x='510' y='68' width='10' height='10'/><rect x='520' y='68' width='10' height='10'/></g>"
			        & "<text x='1420' y='36' text-anchor='end' font-size='16' font-weight='bold' fill='%230E0E0C'>Deere &amp; Company &%23183; NYSE: DE</text>"
			        & "<text x='1420' y='62' text-anchor='end' font-size='15' fill='%230E0E0C'>Close " & FORMAT(_price, "$#,##0.00") & " on " & FORMAT(_date, "d mmm yyyy") & " &%23183; reported through " & [Latest Period Label] & "</text>"
			        & "<rect x='0' y='86' width='1420' height='4' fill='%230E0E0C'/></svg>"
