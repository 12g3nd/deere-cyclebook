			            "<rect x='253.5' y='5.5' width='109' height='53' rx='12' fill='%230E0E0C' stroke='%230E0E0C' stroke-width='3'/><rect x='249.5' y='1.5' width='109' height='53' rx='12' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='3'/><text x='304' y='34' text-anchor='middle' font-size='17' font-weight='bold' fill='%230E0E0C'>Bull</text>")
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: d853f741-d7b7-4ab8-a2e7-029f3ee383b3

