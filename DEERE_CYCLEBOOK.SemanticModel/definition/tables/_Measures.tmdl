	/// The Stack: SOURCES finding, what the three provenance tags mean.
	measure 'SVG Sources Finding' =
			VAR _none = 0
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='84' viewBox='0 0 1420 84' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & "<text x='0' y='30' font-size='24' font-weight='bold' fill='%230E0E0C'>" & "I tagged every figure in the ledgers with where it came from." & "</text>"
			        & "<text x='0' y='70' font-size='22' fill='%230E0E0C'>" & "ACTUAL is what Deere, FRED or Nasdaq reported. GUIDANCE is what management expects. MODEL is what I assumed." & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 1d68d677-0182-4198-b5a2-abd530afe9a3

	/// The Stack: the source registry, one row per source with its provenance tag, type, notes and location.
	measure 'SVG Sources Exhibit' =
			VAR _rows = ADDCOLUMNS(ALL('Source Registry'), "@i", RANKX(ALL('Source Registry'), SWITCH('Source Registry'[Classification], "Actual", "1", "Guidance", "2", "3") & 'Source Registry'[Source], , ASC, DENSE) - 1)
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='960' height='620' viewBox='0 0 960 620' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs><text x='0' y='22' font-size='16' font-weight='bold' fill='%230E0E0C'>The sources behind each number</text><rect x='0' y='38' width='960' height='3' fill='%230E0E0C'/>"
			        & CONCATENATEX(_rows,
			            VAR _y = 41 + [@i] * 50
			            VAR _cls = 'Source Registry'[Classification]
			            RETURN "<g transform='translate(0," & _y & ")'>"
			                & SWITCH(_cls, "Actual", "<rect x='0' y='17' width='54' height='16' fill='%230E0E0C'/><text x='27' y='29' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>", "Guidance", "<rect x='0' y='17' width='72' height='16' fill='%23367C2B'/><text x='36' y='29' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>", "<rect x='0.75' y='17.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='21' width='8' height='8' fill='url(%23s)'/><text x='36' y='29' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>")
			                & "<text x='92' y='21' font-size='14' font-weight='bold' fill='%230E0E0C'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('Source Registry'[Source], "&", "&amp;"), "%", "%25"), "#", "%23") & "<tspan font-size='12' font-weight='normal'>  &%23183;  " & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('Source Registry'[Source Type], "&", "&amp;"), "%", "%25"), "#", "%23") & "</tspan></text>"
			                & "<text x='92' y='40' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('Source Registry'[Notes], "Bear/Base/Bull assumptions are explicitly modeled, never presented as actuals", "The bear, base and bull cases I built for this report"),"Bundled: DE-3Q26-News-Release.pdf", "investor.deere.com, Q3 FY2026 release"), "Bundled in sources/", "investor.deere.com"), "; live refresh", ""), "Live-refresh macroeconomic", "Macroeconomic"), "&", "&amp;"), "%", "%25"), "#", "%23") & "  &%23183;  " & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE('Source Registry'[URL / Location], "https://", ""), "www.", ""), "Bear/Base/Bull assumptions are explicitly modeled, never presented as actuals", "The bear, base and bull cases I built for this report"),"Bundled: DE-3Q26-News-Release.pdf", "investor.deere.com, Q3 FY2026 release"), "Bundled in sources/", "investor.deere.com"), "; live refresh", ""), "Live-refresh macroeconomic", "Macroeconomic"), "&", "&amp;"), "%", "%25"), "#", "%23") & "</text>"
			                & "<rect x='0' y='49' width='960' height='1' fill='%230E0E0C'/></g>",
			            "", [@i], ASC)
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 21d26747-0ef4-4ac0-996d-f18faf17b293

	/// The Stack: SOURCES ledger of how current each input is.
	measure 'SVG Sources Ledger' =
			"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='440' height='572' viewBox='0 0 440 572' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & "<rect x='0' y='0' width='440' height='3' fill='%230E0E0C'/><rect x='0' y='38' width='54' height='16' fill='%230E0E0C'/><text x='27' y='50' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='26' font-size='15' font-weight='bold' fill='%230E0E0C'>" & "Latest Deere quarter" & "</text>"
			        & "<text x='62' y='51' font-size='13' fill='%230E0E0C'>" & "From Deere's earnings release" & "</text>"
			        & "<g fill='%230E0E0C'>" & (
			        VAR _ptrl0 = [Latest Period Label]
			        VAR _pxrl0 = (440 - (LEN([Latest Period Label]) * 30 - 5))
			        VAR _pyrl0 = 66
			        RETURN
			            CONCATENATEX(
			                GENERATE(
			                    SELECTCOLUMNS(GENERATESERIES(1, LEN(_ptrl0), 1), "cirl0", [Value]),
			                    VAR _bits = LOOKUPVALUE('Glyphs'[Bits], 'Glyphs'[Code], UNICODE(MID(_ptrl0, [cirl0], 1)), REPT("0", 35))
			                    RETURN FILTER(SELECTCOLUMNS(GENERATESERIES(0, 34, 1), "cellrl0", [Value]), MID(_bits, [cellrl0] + 1, 1) = "1")
			                ),
			                "<rect x='" & (_pxrl0 + ([cirl0] - 1) * 30 + MOD([cellrl0], 5) * 5) & "' y='" & (_pyrl0 + INT([cellrl0] / 5) * 5) & "' width='5' height='5'/>",
			                ""
			            )
			    ) & "</g>"
			        & "<rect x='0' y='112' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='146' width='54' height='16' fill='%230E0E0C'/><text x='27' y='158' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='136' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Latest share price" & "</text>"
			        & "<text x='62' y='159' font-size='12' fill='%230E0E0C'>" & "Nasdaq close " & FORMAT([Latest Price], "$0.00") & "</text>"
			        & "<text x='440' y='157' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT([Latest Price Date], "d mmm yyyy") & "</text>"
			        & "<rect x='0' y='188' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='222' width='54' height='16' fill='%230E0E0C'/><text x='27' y='234' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='212' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Latest monthly FRED reading" & "</text>"
			        & "<text x='62' y='235' font-size='12' fill='%230E0E0C'>" & "Corn, soybeans, rates, housing" & "</text>"
			        & "<text x='440' y='233' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT(CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] <> "CAD per USD"), "mmm yyyy") & "</text>"
			        & "<rect x='0' y='264' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='298' width='54' height='16' fill='%230E0E0C'/><text x='27' y='310' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='288' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Latest net farm income" & "</text>"
			        & "<text x='62' y='311' font-size='12' fill='%230E0E0C'>" & "BEA via FRED, published yearly" & "</text>"
			        & "<text x='440' y='309' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT(YEAR(CALCULATE(MAX('Farm Income'[Date]), REMOVEFILTERS('Farm Income'))), "0") & "</text>"
			        & "<rect x='0' y='340' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='374' width='72' height='16' fill='%23367C2B'/><text x='36' y='386' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='364' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Management guidance" & "</text>"
			        & "<text x='80' y='387' font-size='12' fill='%230E0E0C'>" & "Q3 FY2026 release" & "</text>"
			        & "<text x='440' y='385' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "20 Aug 2026" & "</text>"
			        & "<rect x='0' y='416' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='450' width='54' height='16' fill='%230E0E0C'/><text x='27' y='462' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='440' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Diluted shares used" & "</text>"
			        & "<text x='62' y='463' font-size='12' fill='%230E0E0C'>" & "Q3 FY2026 average" & "</text>"
			        & "<text x='440' y='461' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "269.8M" & "</text>"
			        & "<rect x='0' y='492' width='440' height='1' fill='%230E0E0C'/><rect x='290' y='502' width='150' height='56' fill='url(%23g)'/><rect x='0.75' y='526.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='530' width='8' height='8' fill='url(%23s)'/><text x='36' y='538' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<text x='0' y='516' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Scenarios and P/E range" & "</text>"
			        & "<text x='68' y='539' font-size='12' fill='%230E0E0C'>" & "Bear, base and bull" & "</text>"
			        & "<text x='430' y='537' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C' stroke='%23F4F4F0' stroke-width='7' stroke-linejoin='round' paint-order='stroke'>" & FORMAT(MINX(ALL('PE Multiple'), 'PE Multiple'[P/E Multiple]), "0") & "x-" & FORMAT(MAXX(ALL('PE Multiple'), 'PE Multiple'[P/E Multiple]), "0") & "x" & "</text>"
			        & "<rect x='0' y='569' width='440' height='2' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 4559ea88-143f-465c-8f9e-5d3fdf4883dc

	column Dummy
		dataType: int64
		isHidden
		lineageTag: 7de1285a-2741-4bc4-8ad7-fdfd73d9042c
		summarizeBy: none
		sourceColumn: Dummy

	partition _Measures = m
		mode: import
		source =
				let
					Source = #table(type table [Dummy = Int64.Type], {{1}})
				in
					Source

