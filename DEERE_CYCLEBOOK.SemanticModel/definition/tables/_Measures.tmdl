10' height='10'/><rect x='160' y='68' width='10' height='10'/><rect x='180' y='8' width='10' height='10'/><rect x='220' y='8' width='10' height='10'/><rect x='180' y='18' width='10' height='10'/><rect x='220' y='18' width='10' height='10'/><rect x='180' y='28' width='10' height='10'/><rect x='220' y='28' width='10' height='10'/><rect x='180' y='38' width='10' height='10'/><rect x='220' y='38' width='10' height='10'/><rect x='180' y='48' width='10' height='10'/><rect x='220' y='48' width='10' height='10'/><rect x='180' y='58' width='10' height='10'/><rect x='220' y='58' width='10' height='10'/><rect x='190' y='68' width='10' height='10'/><rect x='200' y='68' width='10' height='10'/><rect x='210' y='68' width='10' height='10'/><rect x='250' y='8' width='10' height='10'/><rect x='260' y='8' width='10' height='10'/><rect x='270' y='8' width='10' height='10'/><rect x='240' y='18' width='10' height='10'/><rect x='280' y='18' width='10' height='10'/><rect x='240' y='28' width='10' height='10'/><rect x='280' y='28' width='10' height='10'/><rect x='240' y='38' width='10' height='10'/><rect x='250' y='38' width='10' height='10'/><rect x='260' y='38' width='10' height='10'/><rect x='270' y='38' width='10' height='10'/><rect x='280' y='38' width='10' height='10'/><rect x='240' y='48' width='10' height='10'/><rect x='280' y='48' width='10' height='10'/><rect x='240' y='58' width='10' height='10'/><rect x='280' y='58' width='10' height='10'/><rect x='240' y='68' width='10' height='10'/><rect x='280' y='68' width='10' height='10'/><rect x='300' y='8' width='10' height='10'/><rect x='310' y='8' width='10' height='10'/><rect x='320' y='8' width='10' height='10'/><rect x='330' y='8' width='10' height='10'/><rect x='340' y='8' width='10' height='10'/><rect x='320' y='18' width='10' height='10'/><rect x='320' y='28' width='10' height='10'/><rect x='320' y='38' width='10' height='10'/><rect x='320' y='48' width='10' height='10'/><rect x='320' y='58' width='10' height='10'/><rect x='320' y='68' width='10' height='10'/><rect x='370' y='8' width='10' height='10'/><rect x='380' y='8' width='10' height='10'/><rect x='390' y='8' width='10' height='10'/><rect x='380' y='18' width='10' height='10'/><rect x='380' y='28' width='10' height='10'/><rect x='380' y='38' width='10' height='10'/><rect x='380' y='48' width='10' height='10'/><rect x='380' y='58' width='10' height='10'/><rect x='370' y='68' width='10' height='10'/><rect x='380' y='68' width='10' height='10'/><rect x='390' y='68' width='10' height='10'/><rect x='430' y='8' width='10' height='10'/><rect x='440' y='8' width='10' height='10'/><rect x='450' y='8' width='10' height='10'/><rect x='420' y='18' width='10' height='10'/><rect x='460' y='18' width='10' height='10'/><rect x='420' y='28' width='10' height='10'/><rect x='460' y='28' width='10' height='10'/><rect x='420' y='38' width='10' height='10'/><rect x='460' y='38' width='10' height='10'/><rect x='420' y='48' width='10' height='10'/><rect x='460' y='48' width='10' height='10'/><rect x='420' y='58' width='10' height='10'/><rect x='460' y='58' width='10' height='10'/><rect x='430' y='68' width='10' height='10'/><rect x='440' y='68' width='10' height='10'/><rect x='450' y='68' width='10' height='10'/><rect x='480' y='8' width='10' height='10'/><rect x='520' y='8' width='10' height='10'/><rect x='480' y='18' width='10' height='10'/><rect x='520' y='18' width='10' height='10'/><rect x='480' y='28' width='10' height='10'/><rect x='490' y='28' width='10' height='10'/><rect x='520' y='28' width='10' height='10'/><rect x='480' y='38' width='10' height='10'/><rect x='500' y='38' width='10' height='10'/><rect x='520' y='38' width='10' height='10'/><rect x='480' y='48' width='10' height='10'/><rect x='510' y='48' width='10' height='10'/><rect x='520' y='48' width='10' height='10'/><rect x='480' y='58' width='10' height='10'/><rect x='520' y='58' width='10' height='10'/><rect x='480' y='68' width='10' height='10'/><rect x='520' y='68' width='10' height='10'/></g>"
			        & "<text x='1420' y='36' text-anchor='end' font-size='16' font-weight='bold' fill='%230E0E0C'>Deere &amp; Company &%23183; NYSE: DE</text>"
			        & "<text x='1420' y='62' text-anchor='end' font-size='15' fill='%230E0E0C'>Close " & FORMAT(_price, "$#,##0.00") & " on " & FORMAT(_date, "d mmm yyyy") & " &%23183; reported through " & [Latest Period Label] & "</text>"
			        & "<rect x='0' y='86' width='1420' height='4' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
