 y='68' width='10' height='10'/><rect x='370' y='8' width='10' height='10'/><rect x='380' y='8' width='10' height='10'/><rect x='390' y='8' width='10' height='10'/><rect x='380' y='18' width='10' height='10'/><rect x='380' y='28' width='10' height='10'/><rect x='380' y='38' width='10' height='10'/><rect x='380' y='48' width='10' height='10'/><rect x='380' y='58' width='10' height='10'/><rect x='370' y='68' width='10' height='10'/><rect x='380' y='68' width='10' height='10'/><rect x='390' y='68' width='10' height='10'/><rect x='430' y='8' width='10' height='10'/><rect x='440' y='8' width='10' height='10'/><rect x='450' y='8' width='10' height='10'/><rect x='420' y='18' width='10' height='10'/><rect x='460' y='18' width='10' height='10'/><rect x='420' y='28' width='10' height='10'/><rect x='460' y='28' width='10' height='10'/><rect x='420' y='38' width='10' height='10'/><rect x='460' y='38' width='10' height='10'/><rect x='420' y='48' width='10' height='10'/><rect x='460' y='48' width='10' height='10'/><rect x='420' y='58' width='10' height='10'/><rect x='460' y='58' width='10' height='10'/><rect x='430' y='68' width='10' height='10'/><rect x='440' y='68' width='10' height='10'/><rect x='450' y='68' width='10' height='10'/><rect x='480' y='8' width='10' height='10'/><rect x='520' y='8' width='10' height='10'/><rect x='480' y='18' width='10' height='10'/><rect x='520' y='18' width='10' height='10'/><rect x='480' y='28' width='10' height='10'/><rect x='490' y='28' width='10' height='10'/><rect x='520' y='28' width='10' height='10'/><rect x='480' y='38' width='10' height='10'/><rect x='500' y='38' width='10' height='10'/><rect x='520' y='38' width='10' height='10'/><rect x='480' y='48' width='10' height='10'/><rect x='510' y='48' width='10' height='10'/><rect x='520' y='48' width='10' height='10'/><rect x='480' y='58' width='10' height='10'/><rect x='520' y='58' width='10' height='10'/><rect x='480' y='68' width='10' height='10'/><rect x='520' y='68' width='10' height='1