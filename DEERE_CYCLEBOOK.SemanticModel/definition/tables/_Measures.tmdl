	/// The Stack: THE CYCLE finding, how the outside drivers moved over the past year; always names each driver's direction.
	measure 'SVG Cycle Finding' =
			VAR _dC = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn")
			VAR _vC = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Date] = _dC)
			VAR _pC = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Date] = EDATE(_dC, -12))
			VAR _dS = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans")
			VAR _vS = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans", 'Macro Data'[Date] = _dS)
			VAR _pS = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans", 'Macro Data'[Date] = EDATE(_dS, -12))
			VAR _dF = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds")
			VAR _vF = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds", 'Macro Data'[Date] = _dF)
			VAR _pF = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds", 'Macro Data'[Date] = EDATE(_dF, -12))
			VAR _dH = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts")
			VAR _vH = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts", 'Macro Data'[Date] = _dH)
			VAR _pH = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts", 'Macro Data'[Date] = EDATE(_dH, -12))
			VAR _cPk = CALCULATE(MAX('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn")
			VAR _cPkD = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Value] = _cPk)
			VAR _fiY = CALCULATE(MAX('Farm Income'[Date]), REMOVEFILTERS('Farm Income'))
			VAR _fiV = CALCULATE(AVERAGE('Farm Income'[Net Farm Income]), REMOVEFILTERS('Farm Income'), 'Farm Income'[Date] = _fiY)
			VAR _fiPk = CALCULATE(MAX('Farm Income'[Net Farm Income]), REMOVEFILTERS('Farm Income'))
			VAR _fiPkY = CALCULATE(MAX('Farm Income'[Date]), REMOVEFILTERS('Farm Income'), 'Farm Income'[Net Farm Income] = _fiPk)
			VAR _month = FORMAT(_dC, "mmmm yyyy")
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='84' viewBox='0 0 1420 84' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & "<text x='0' y='30' font-size='24' font-weight='bold' fill='%230E0E0C'>" & IF(_vC >= _pC && _vS >= _pS && _vF < _pF && _vH < _pH, "Crop prices and rates moved in farmers' favour this year. Housing starts kept falling.", (VAR _t = {("corn prices", INT(_vC < _pC)), ("soybean prices", INT(_vS < _pS)), ("interest rates", INT(_vF >= _pF)), ("housing starts", INT(_vH < _pH))}
			            VAR _bad = COUNTROWS(FILTER(_t, [Value2] = 1))
			            VAR _good = 4 - _bad
			            VAR _misses = CONCATENATEX(FILTER(_t, [Value2] = 1), [Value1], " and ")
			            RETURN IF(_bad = 0, "All four demand signals went Deere's way this year.",
			                IF(_good = 0, "None of the four demand signals went Deere's way this year.",
			                    IF(_good = 1, "One of four demand signals went Deere's way this year: " & CONCATENATEX(FILTER(_t, [Value2] = 0), [Value1]) & ".",
			                        SWITCH(_good, 2, "Two", "Three") & " of four demand signals went Deere's way this year. " & UPPER(LEFT(_misses, 1)) & MID(_misses, 2, 99) & " didn't."))))) & "</text>"
			        & "<text x='0' y='70' font-size='22' fill='%230E0E0C'>" & _month & " vs a year earlier: corn " & SUBSTITUTE(FORMAT(DIVIDE(_vC, _pC) - 1, "+0%;-0%"), "%", "%25") & ", soybeans " & SUBSTITUTE(FORMAT(DIVIDE(_vS, _pS) - 1, "+0%;-0%"), "%", "%25") & ", fed funds " & FORMAT(_vF, "0.00") & "%25 (was " & FORMAT(_pF, "0.00") & "%25), housing starts " & SUBSTITUTE(FORMAT(DIVIDE(_vH, _pH) - 1, "+0%;-0%"), "%", "%25") & "." & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: ddc4d712-cee9-4aec-973c-173ba6e044ca

	/// The Stack: crop prices and the fed funds rate as the lead panels, with housing starts and net farm income on the same 2020-2026 axis.
	measure 'SVG Cycle Exhibit' =
			VAR _dC = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn")
			VAR _vC = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Date] = _dC)
			VAR _pC = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Date] = EDATE(_dC, -12))
			VAR _dS = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans")
			VAR _vS = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans", 'Macro Data'[Date] = _dS)
			VAR _pS = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans", 'Macro Data'[Date] = EDATE(_dS, -12))
			VAR _dF = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds")
			VAR _vF = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds", 'Macro Data'[Date] = _dF)
			VAR _pF = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds", 'Macro Data'[Date] = EDATE(_dF, -12))
			VAR _dH = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts")
			VAR _vH = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts", 'Macro Data'[Date] = _dH)
			VAR _pH = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts", 'Macro Data'[Date] = EDATE(_dH, -12))
			VAR _cPk = CALCULATE(MAX('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn")
			VAR _cPkD = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Value] = _cPk)
			VAR _fiY = CALCULATE(MAX('Farm Income'[Date]), REMOVEFILTERS('Farm Income'))
			VAR _fiV = CALCULATE(AVERAGE('Farm Income'[Net Farm Income]), REMOVEFILTERS('Farm Income'), 'Farm Income'[Date] = _fiY)
			VAR _fiPk = CALCULATE(MAX('Farm Income'[Net Farm Income]), REMOVEFILTERS('Farm Income'))
			VAR _fiPkY = CALCULATE(MAX('Farm Income'[Date]), REMOVEFILTERS('Farm Income'), 'Farm Income'[Net Farm Income] = _fiPk)
			VAR _month = FORMAT(_dC, "mmmm yyyy")
			VAR _maxD = MAX(MAX(_dC, _dF), _dH)
			VAR _n = DATEDIFF(DATE(2020, 1, 1), _maxD, MONTH)
			VAR _kL = 510 / _n
			VAR _kS = 130 / _n
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='960' height='620' viewBox='0 0 960 620' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><text x='0' y='58' font-size='15' font-weight='bold' fill='%230E0E0C'>Corn and soybeans, USD per tonne</text><line x1='50' y1='239.63636363636363' x2='560' y2='239.63636363636363' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='42' y='244.63636363636363' text-anchor='end' font-size='12' fill='%230E0E0C'>$200</text><line x1='50' y1='166.90909090909093' x2='560' y2='166.90909090909093' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='42' y='171.90909090909093' text-anchor='end' font-size='12' fill='%230E0E0C'>$400</text><line x1='50' y1='94.18181818181819' x2='560' y2='94.18181818181819' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='42' y='99.18181818181819' text-anchor='end' font-size='12' fill='%230E0E0C'>$600</text><rect x='50' y='275' width='510' height='3' fill='%230E0E0C'/><text x='0' y='348' font-size='15' font-weight='bold' fill='%230E0E0C'>Federal funds rate</text><line x1='50' y1='499.33333333333337' x2='560' y2='499.33333333333337' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='42' y='504.33333333333337' text-anchor='end' font-size='12' fill='%230E0E0C'>2%25</text><line x1='50' y1='432.6666666666667' x2='560' y2='432.6666666666667' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='42' y='437.6666666666667' text-anchor='end' font-size='12' fill='%230E0E0C'>4%25</text><line x1='50' y1='366' x2='560' y2='366' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='42' y='371' text-anchor='end' font-size='12' fill='%230E0E0C'>6%25</text><rect x='50' y='565' width='510' height='3' fill='%230E0E0C'/><text x='680' y='58' font-size='14' font-weight='bold' fill='%230E0E0C'>Housing starts, thousands</text><line x1='730' y1='190.54545454545453' x2='860' y2='190.54545454545453' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='722' y='195.54545454545453' text-anchor='end' font-size='12' fill='%230E0E0C'>1,000</text><line x1='730' y1='139.63636363636363' x2='860' y2='139.63636363636363' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='722' y='144.63636363636363' text-anchor='end' font-size='12' fill='%230E0E0C'>1,400</text><line x1='730' y1='88.72727272727273' x2='860' y2='88.72727272727273' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='722' y='93.72727272727273' text-anchor='end' font-size='12' fill='%230E0E0C'>1,800</text><rect x='730' y='215' width='130' height='3' fill='%230E0E0C'/><text x='680' y='348' font-size='14' font-weight='bold' fill='%230E0E0C'>U.S. net farm income, $B</text><line x1='730' y1='436' x2='860' y2='436' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='722' y='441' text-anchor='end' font-size='12' fill='%230E0E0C'>$100</text><line x1='730' y1='366' x2='860' y2='366' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='722' y='371' text-anchor='end' font-size='12' fill='%230E0E0C'>$200</text><rect x='730' y='505' width='130' height='3' fill='%230E0E0C'/>"
			        & "<text x='0' y='22' font-size='16' font-weight='bold' fill='%230E0E0C'>What Deere's customers are dealing with, 2020 to " & YEAR(_maxD) & "</text>"
			        & CONCATENATEX(FILTER(GENERATESERIES(2020, YEAR(_maxD)), MOD([Value], 1) = 0), "<rect x='" & ROUND(50 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kL, 1) & "' y='278' width='1' height='6' fill='%230E0E0C'/><text x='" & ROUND(50 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kL, 1) & "' y='298' text-anchor='middle' font-size='12' fill='%230E0E0C'>" & [Value] & "</text>", "")
			        & CONCATENATEX(FILTER(GENERATESERIES(2020, YEAR(_maxD)), MOD([Value], 1) = 0), "<rect x='" & ROUND(50 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kL, 1) & "' y='568' width='1' height='6' fill='%230E0E0C'/><text x='" & ROUND(50 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kL, 1) & "' y='588' text-anchor='middle' font-size='12' fill='%230E0E0C'>" & [Value] & "</text>", "")
			        & CONCATENATEX(FILTER(GENERATESERIES(2020, YEAR(_maxD)), MOD([Value], 2) = 0), "<rect x='" & ROUND(730 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kS, 1) & "' y='218' width='1' height='6' fill='%230E0E0C'/><text x='" & ROUND(730 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kS, 1) & "' y='238' text-anchor='middle' font-size='12' fill='%230E0E0C'>" & [Value] & "</text>", "")
			        & CONCATENATEX(FILTER(GENERATESERIES(2020, YEAR(_maxD)), MOD([Value], 2) = 0), "<rect x='" & ROUND(730 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kS, 1) & "' y='508' width='1' height='6' fill='%230E0E0C'/><text x='" & ROUND(730 + DATEDIFF(DATE(2020, 1, 1), DATE([Value], 1, 1), MONTH) * _kS, 1) & "' y='528' text-anchor='middle' font-size='12' fill='%230E0E0C'>" & [Value] & "</text>", "")
			        & (VAR _r = CALCULATETABLE(SELECTCOLUMNS('Macro Data', "@d", 'Macro Data'[Date], "@v", 'Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans", 'Macro Data'[Date] >= DATE(2020, 1, 1))
			           VAR _ld = MAXX(_r, [@d])
			           VAR _lv = MAXX(FILTER(_r, [@d] = _ld), [@v])
			           RETURN "<polyline fill='none' stroke='%230E0E0C' stroke-width='5' points='" & CONCATENATEX(_r, ROUND(50 + DATEDIFF(DATE(2020, 1, 1), [@d], MONTH) * _kL, 1) & "," & ROUND(276 - (MIN(MAX([@v], 100), 650) - 100) / 550 * 200, 1), " ", [@d], ASC) & "'/>"
			               & "<text x='568' y='" & (ROUND(276 - (MIN(MAX(_lv, 100), 650) - 100) / 550 * 200, 1) + 5) & "' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Soy $" & FORMAT(_lv, "0") & "</text>")
			        & (VAR _r = CALCULATETABLE(SELECTCOLUMNS('Macro Data', "@d", 'Macro Data'[Date], "@v", 'Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Date] >= DATE(2020, 1, 1))
			           VAR _ld = MAXX(_r, [@d])
			           VAR _lv = MAXX(FILTER(_r, [@d] = _ld), [@v])
			           RETURN "<polyline fill='none' stroke='%230E0E0C' stroke-width='3' stroke-dasharray='8 5' points='" & CONCATENATEX(_r, ROUND(50 + DATEDIFF(DATE(2020, 1, 1), [@d], MONTH) * _kL, 1) & "," & ROUND(276 - (MIN(MAX([@v], 100), 650) - 100) / 550 * 200, 1), " ", [@d], ASC) & "'/>"
			               & "<text x='568' y='" & (ROUND(276 - (MIN(MAX(_lv, 100), 650) - 100) / 550 * 200, 1) + 5) & "' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Corn $" & FORMAT(_lv, "0") & "</text>")
			        & (VAR _r = CALCULATETABLE(SELECTCOLUMNS('Macro Data', "@d", 'Macro Data'[Date], "@v", 'Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds", 'Macro Data'[Date] >= DATE(2020, 1, 1))
			           VAR _ld = MAXX(_r, [@d])
			           VAR _lv = MAXX(FILTER(_r, [@d] = _ld), [@v])
			           RETURN "<polyline fill='none' stroke='%230E0E0C' stroke-width='4' points='" & CONCATENATEX(_r, ROUND(50 + DATEDIFF(DATE(2020, 1, 1), [@d], MONTH) * _kL, 1) & "," & ROUND(566 - (MIN(MAX([@v], 0), 6) - 0) / 6 * 200, 1), " ", [@d], ASC) & "'/>"
			               & "<text x='568' y='" & (ROUND(566 - (MIN(MAX(_lv, 0), 6) - 0) / 6 * 200, 1) + 5) & "' font-size='14' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_lv, "0.00") & "%25" & "</text>")
			        & (VAR _r = CALCULATETABLE(SELECTCOLUMNS('Macro Data', "@d", 'Macro Data'[Date], "@v", 'Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts", 'Macro Data'[Date] >= DATE(2020, 1, 1))
			           VAR _ld = MAXX(_r, [@d])
			           VAR _lv = MAXX(FILTER(_r, [@d] = _ld), [@v])
			           RETURN "<polyline fill='none' stroke='%230E0E0C' stroke-width='3' points='" & CONCATENATEX(_r, ROUND(730 + DATEDIFF(DATE(2020, 1, 1), [@d], MONTH) * _kS, 1) & "," & ROUND(216 - (MIN(MAX([@v], 800), 1900) - 800) / 1100 * 140, 1), " ", [@d], ASC) & "'/>"
			               & "<text x='868' y='" & (ROUND(216 - (MIN(MAX(_lv, 800), 1900) - 800) / 1100 * 140, 1) + 5) & "' font-size='14' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_lv, "#,##0") & "K" & "</text>")
			        & (VAR _fi = FILTER(SELECTCOLUMNS(ALL('Farm Income'), "@y", YEAR('Farm Income'[Date]), "@v", 'Farm Income'[Net Farm Income]), [@y] >= 2020)
			           VAR _bw = ROUND(12 * _kS * 0.7, 1)
			           RETURN CONCATENATEX(_fi, "<rect x='" & ROUND(ROUND(730 + DATEDIFF(DATE(2020, 1, 1), DATE([@y], 7, 1), MONTH) * _kS, 1) - _bw / 2, 1) & "' y='" & ROUND(506 - (MIN(MAX([@v], 0), 200) - 0) / 200 * 140, 1) & "' width='" & _bw & "' height='" & ROUND(506 - ROUND(506 - (MIN(MAX([@v], 0), 200) - 0) / 200 * 140, 1), 1) & "' fill='%230E0E0C'/>", "", [@y], ASC)
			               & "<text x='868' y='" & (ROUND(506 - (MIN(MAX(_fiV, 0), 200) - 0) / 200 * 140, 1) + 5) & "' font-size='14' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_fiV, "$0") & "B</text>"
			               & "<text x='" & ROUND(ROUND(730 + DATEDIFF(DATE(2020, 1, 1), DATE(YEAR(_fiY) + 1, 1, 1), MONTH) * _kS, 1) + 4, 1) & "' y='496' font-size='11' fill='%230E0E0C'>no data after " & YEAR(_fiY) & "</text>")
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 26f0dd88-32be-44eb-8ba5-273d6586111e

	/// The Stack: THE CYCLE ledger of the latest FRED readings.
	measure 'SVG Cycle Ledger' =
			VAR _dC = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn")
			VAR _vC = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Date] = _dC)
			VAR _pC = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Date] = EDATE(_dC, -12))
			VAR _dS = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans")
			VAR _vS = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans", 'Macro Data'[Date] = _dS)
			VAR _pS = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Soybeans", 'Macro Data'[Date] = EDATE(_dS, -12))
			VAR _dF = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds")
			VAR _vF = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds", 'Macro Data'[Date] = _dF)
			VAR _pF = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Federal Funds", 'Macro Data'[Date] = EDATE(_dF, -12))
			VAR _dH = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts")
			VAR _vH = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts", 'Macro Data'[Date] = _dH)
			VAR _pH = CALCULATE(AVERAGE('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Housing Starts", 'Macro Data'[Date] = EDATE(_dH, -12))
			VAR _cPk = CALCULATE(MAX('Macro Data'[Value]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn")
			VAR _cPkD = CALCULATE(MAX('Macro Data'[Date]), REMOVEFILTERS('Macro Data'), 'Macro Data'[Series] = "Corn", 'Macro Data'[Value] = _cPk)
			VAR _fiY = CALCULATE(MAX('Farm Income'[Date]), REMOVEFILTERS('Farm Income'))
			VAR _fiV = CALCULATE(AVERAGE('Farm Income'[Net Farm Income]), REMOVEFILTERS('Farm Income'), 'Farm Income'[Date] = _fiY)
			VAR _fiPk = CALCULATE(MAX('Farm Income'[Net Farm Income]), REMOVEFILTERS('Farm Income'))
			VAR _fiPkY = CALCULATE(MAX('Farm Income'[Date]), REMOVEFILTERS('Farm Income'), 'Farm Income'[Net Farm Income] = _fiPk)
			VAR _month = FORMAT(_dC, "mmmm yyyy")
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='440' height='496' viewBox='0 0 440 496' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & "<rect x='0' y='0' width='440' height='3' fill='%230E0E0C'/><rect x='0' y='38' width='54' height='16' fill='%230E0E0C'/><text x='27' y='50' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='26' font-size='15' font-weight='bold' fill='%230E0E0C'>" & "Corn, USD per tonne, " & FORMAT(_dC, "mmm yyyy") & "</text>"
			        & "<text x='62' y='51' font-size='13' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_vC, _pC) - 1, "+0%;-0%;0%"), "%", "%25") & " vs a year earlier" & "</text>"
			        & "<g fill='%230E0E0C'>" & (
			        VAR _ptcl0 = "$" & FORMAT(_vC, "0")
			        VAR _pxcl0 = (440 - (LEN("$" & FORMAT(_vC, "0")) * 30 - 5))
			        VAR _pycl0 = 66
			        RETURN
			            CONCATENATEX(
			                GENERATE(
			                    SELECTCOLUMNS(GENERATESERIES(1, LEN(_ptcl0), 1), "cicl0", [Value]),
			                    VAR _bits = LOOKUPVALUE('Glyphs'[Bits], 'Glyphs'[Code], UNICODE(MID(_ptcl0, [cicl0], 1)), REPT("0", 35))
			                    RETURN FILTER(SELECTCOLUMNS(GENERATESERIES(0, 34, 1), "cellcl0", [Value]), MID(_bits, [cellcl0] + 1, 1) = "1")
			                ),
			                "<rect x='" & (_pxcl0 + ([cicl0] - 1) * 30 + MOD([cellcl0], 5) * 5) & "' y='" & (_pycl0 + INT([cellcl0] / 5) * 5) & "' width='5' height='5'/>",
			                ""
			            )
			    ) & "</g>"
			        & "<rect x='0' y='112' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='146' width='54' height='16' fill='%230E0E0C'/><text x='27' y='158' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='136' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Soybeans, USD per tonne, " & FORMAT(_dS, "mmm yyyy") & "</text>"
			        & "<text x='62' y='159' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_vS, _pS) - 1, "+0%;-0%;0%"), "%", "%25") & " vs a year earlier" & "</text>"
			        & "<text x='440' y='157' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_vS, "0") & "</text>"
			        & "<rect x='0' y='188' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='222' width='54' height='16' fill='%230E0E0C'/><text x='27' y='234' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='212' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Federal funds rate, " & FORMAT(_dF, "mmm yyyy") & "</text>"
			        & "<text x='62' y='235' font-size='12' fill='%230E0E0C'>" & FORMAT(_pF, "0.00") & "%25 a year earlier" & "</text>"
			        & "<text x='440' y='233' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_vF, "0.00") & "%25" & "</text>"
			        & "<rect x='0' y='264' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='298' width='54' height='16' fill='%230E0E0C'/><text x='27' y='310' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='288' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Housing starts, " & FORMAT(_dH, "mmm yyyy") & "</text>"
			        & "<text x='62' y='311' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_vH, _pH) - 1, "+0%;-0%;0%"), "%", "%25") & " vs a year earlier" & "</text>"
			        & "<text x='440' y='309' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_vH, "#,##0") & "K" & "</text>"
			        & "<rect x='0' y='340' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='374' width='54' height='16' fill='%230E0E0C'/><text x='27' y='386' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='364' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "U.S. net farm income, " & YEAR(_fiY) & "</text>"
			        & "<text x='62' y='387' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_fiV, _fiPk) - 1, "+0%;-0%;0%"), "%", "%25") & " from the " & YEAR(_fiPkY) & " peak" & "</text>"
			        & "<text x='440' y='385' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(_fiV, "0.0") & "B" & "</text>"
			        & "<rect x='0' y='416' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='450' width='54' height='16' fill='%230E0E0C'/><text x='27' y='462' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='440' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Corn, against its " & FORMAT(_cPkD, "mmm yyyy") & " peak" & "</text>"
			        & "<text x='62' y='463' font-size='12' fill='%230E0E0C'>" & "$" & FORMAT(_cPk, "0") & " a tonne at the peak" & "</text>"
			        & "<text x='440' y='461' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_vC, _cPk) - 1, "+0%;-0%;0%"), "%", "%25") & "</text>"
			        & "<rect x='0' y='493' width='440' height='2' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 25c3ab30-6b51-4205-8e0e-cc44639dd158

	/// The Stack: MODEL LAB card header.
	measure 'SVG Header MODEL LAB' =
			VAR _price = [Latest Price]
			VAR _date = [Latest Price Date]
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='96' viewBox='0 0 1420 96' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><g fill='%230E0E0C'><rect x='0' y='8' width='10' height='10'/><rect x='40' y='8' width='10' height='10'/><rect x='0' y='18' width='10' height='10'/><rect x='10' y='18' width='10' height='10'/><rect x='30' y='18' width='10' height='10'/><rect x='40' y='18' width='10' height='10'/><rect x='0' y='28' width='10' height='10'/><rect x='20' y='28' width='10' height='10'/><rect x='40' y='28' width='10' height='10'/><rect x='0' y='38' width='10' height='10'/><rect x='20' y='38' width='10' height='10'/><rect x='40' y='38' width='10' height='10'/><rect x='0' y='48' width='10' height='10'/><rect x='40' y='48' width='10' height='10'/><rect x='0' y='58' width='10' height='10'/><rect x='40' y='58' width='10' height='10'/><rect x='0' y='68' width='10' height='10'/><rect x='40' y='68' width='10' height='10'/><rect x='70' y='8' width='10' height='10'/><rect x='80' y='8' width='10' height='10'/><rect x='90' y='8' width='10' height='10'/><rect x='60' y='18' width='10' height='10'/><rect x='100' y='18' width='10' height='10'/><rect x='60' y='28' width='10' height='10'/><rect x='100' y='28' width='10' height='10'/><rect x='60' y='38' width='10' height='10'/><rect x='100' y='38' width='10' height='10'/><rect x='60' y='48' width='10' height='10'/><rect x='100' y='48' width='10' height='10'/><rect x='60' y='58' width='10' height='10'/><rect x='100' y='58' width='10' height='10'/><rect x='70' y='68' width='10' height='10'/><rect x='80' y='68' width='10' height='10'/><rect x='90' y='68' width='10' height='10'/><rect x='120' y='8' width='10' height='10'/><rect x='130' y='8' width='10' height='10'/><rect x='140' y='8' width='10' height='10'/><rect x='120' y='18' width='10' height='10'/><rect x='150' y='18' width='10' height='10'/><rect x='120' y='28' width='10' height='10'/><rect x='160' y='28' width='10' heig