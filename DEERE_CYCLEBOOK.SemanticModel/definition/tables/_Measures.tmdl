><rect x='550' y='8' width='10' height='10'/><rect x='560' y='8' width='10' height='10'/><rect x='570' y='8' width='10' height='10'/><rect x='580' y='8' width='10' height='10'/><rect x='540' y='18' width='10' height='10'/><rect x='540' y='28' width='10' height='10'/><rect x='550' y='38' width='10' height='10'/><rect x='560' y='38' width='10' height='10'/><rect x='570' y='38' width='10' height='10'/><rect x='580' y='48' width='10' height='10'/><rect x='580' y='58' width='10' height='10'/><rect x='540' y='68' width='10' height='10'/><rect x='550' y='68' width='10' height='10'/><rect x='560' y='68' width='10' height='10'/><rect x='570' y='68' width='10' height='10'/></g>"
			        & "<text x='1420' y='36' text-anchor='end' font-size='16' font-weight='bold' fill='%230E0E0C'>Deere &amp; Company &%23183; NYSE: DE</text>"
			        & "<text x='1420' y='62' text-anchor='end' font-size='15' fill='%230E0E0C'>Close " & FORMAT(_price, "$#,##0.00") & " on " & FORMAT(_date, "d mmm yyyy") & " &%23183; reported through " & [Latest Period Label] & "</text>"
			        & "<rect x='0' y='86' width='1420' height='4' fill='%230E0E0C'/></svg>"
