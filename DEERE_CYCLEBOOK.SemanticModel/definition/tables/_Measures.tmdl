	/// The Stack: MODEL LAB finding, modeled operating profit against FY2025 and net income against guidance, for the current settings.
	measure 'SVG Model Lab Finding' =
			VAR _sc = SELECTEDVALUE('Scenario'[Scenario], "Base")
			VAR _sa = [Selected Sales Adjustment]
			VAR _ma = [Selected Margin Adjustment Bps]
			VAR _sales = [Model Equipment Sales]
			VAR _op = [Model Equipment Operating Profit]
			VAR _ni = [Scenario Net Income]
			VAR _eps = [Projected EPS]
			VAR _op25 = CALCULATE(SUM('Annual Segments'[Operating Profit]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025)
			VAR _sales25 = CALCULATE(SUM('Annual Segments'[Net Sales]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025)
			VAR _tax = DIVIDE(-CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 6), CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 7) - CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 6))
			VAR _set = IF(_sa = 0 && _ma = 0, "the ", "your ") & LOWER(_sc) & " case"
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='84' viewBox='0 0 1420 84' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & "<text x='0' y='30' font-size='24' font-weight='bold' fill='%230E0E0C'>" & "In " & _set & ", Deere's equipment business earns " & FORMAT(_op / 1000, "$0.00") & "B in operating profit, " & SUBSTITUTE(FORMAT(ABS(DIVIDE(_op, _op25) - 1), "0%"), "%", "%25") & IF(_op >= _op25, " more", " less") & " than FY2025." & "</text>"
			        & "<text x='0' y='70' font-size='22' fill='%230E0E0C'>" & "Net income comes to " & FORMAT(_ni / 1000, "$0.00") & "B, or " & FORMAT(_eps, "$0.00") & " a share, " & IF(_ni < 4750, "below", IF(_ni > 5000, "above", "inside")) & " the $4.75B-5.00B management expects." & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 04125599-a322-430b-96fc-c5fb93a282cf

	/// The Stack: bridge from FY2025 reported operating profit to the FY2026 model by segment, with the growth and margin assumptions.
	measure 'SVG Model Lab Exhibit' =
			VAR _sc = SELECTEDVALUE('Scenario'[Scenario], "Base")
			VAR _sa = [Selected Sales Adjustment]
			VAR _ma = [Selected Margin Adjustment Bps]
			VAR _sales = [Model Equipment Sales]
			VAR _op = [Model Equipment Operating Profit]
			VAR _ni = [Scenario Net Income]
			VAR _eps = [Projected EPS]
			VAR _op25 = CALCULATE(SUM('Annual Segments'[Operating Profit]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025)
			VAR _sales25 = CALCULATE(SUM('Annual Segments'[Net Sales]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025)
			VAR _tax = DIVIDE(-CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 6), CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 7) - CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 6))
			VAR _set = IF(_sa = 0 && _ma = 0, "the ", "your ") & LOWER(_sc) & " case"
			VAR _run0 = _op25
			VAR _run1 = _run0 + CALCULATE([Model Segment Operating Profit], 'Segment'[Segment Code] = "PPA") - CALCULATE(SUM('Annual Segments'[Operating Profit]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025, 'Annual Segments'[Segment Code] = "PPA")
			VAR _run2 = _run1 + CALCULATE([Model Segment Operating Profit], 'Segment'[Segment Code] = "SAT") - CALCULATE(SUM('Annual Segments'[Operating Profit]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025, 'Annual Segments'[Segment Code] = "SAT")
			VAR _run3 = _run2 + CALCULATE([Model Segment Operating Profit], 'Segment'[Segment Code] = "CF") - CALCULATE(SUM('Annual Segments'[Operating Profit]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025, 'Annual Segments'[Segment Code] = "CF")
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='540' viewBox='0 0 1000 540' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs><text x='0' y='22' font-size='16' font-weight='bold' fill='%230E0E0C'>Equipment operating profit, FY2025 reported to FY2026 model</text><g font-size='13' fill='%230E0E0C'><rect x='0' y='35' width='14' height='14' fill='%230E0E0C'/><text x='22' y='47'>Reported</text><rect x='120' y='35' width='14' height='14' fill='url(%23s)' stroke='%230E0E0C' stroke-width='1.5'/><text x='142' y='47'>CYCLEBOOK model</text></g><line x1='80' y1='331.42' x2='980' y2='331.42' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='70' y='336.42' text-anchor='end' font-size='13' fill='%230E0E0C'>$2B</text><line x1='80' y1='222.84' x2='980' y2='222.84' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='70' y='227.84' text-anchor='end' font-size='13' fill='%230E0E0C'>$4B</text><line x1='80' y1='114.25999999999999' x2='980' y2='114.25999999999999' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='70' y='119.25999999999999' text-anchor='end' font-size='13' fill='%230E0E0C'>$6B</text><rect x='80' y='439' width='900' height='3' fill='%230E0E0C'/><text x='170' y='466' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>FY2025</text><text x='350' y='466' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>PPA</text><text x='530' y='466' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>SAT</text><text x='710' y='466' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>C&amp;F</text><text x='890' y='466' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>FY2026 model</text><rect x='0' y='478' width='1000' height='3' fill='%230E0E0C'/><rect x='0' y='508' width='1000' height='1' fill='%230E0E0C'/><rect x='0' y='537' width='1000' height='2' fill='%230E0E0C'/><g font-size='14' font-weight='bold' fill='%230E0E0C'><text x='0' y='499'>Sales</text><text x='0' y='529'>Margin</text></g>"
			        & "<rect x='115' y='" & ROUND(MAX(60, 440 - (_op25) / 1000 * 54.29), 1) & "' width='110' height='" & (440 - ROUND(MAX(60, 440 - (_op25) / 1000 * 54.29), 1)) & "' fill='%230E0E0C'/>"
			        & "<text x='170' y='" & (ROUND(MAX(60, 440 - (_op25) / 1000 * 54.29), 1) - 13) & "' text-anchor='middle' font-size='15' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_op25 / 1000, "$0.00") & "B</text>"
			        & "<text x='170' y='499' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & FORMAT(_sales25 / 1000, "$0.0") & "B</text>"
			        & "<text x='170' y='529' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_op25, _sales25), "0.0%"), "%", "%25") & "</text>"
			        & (VAR _from = _run0
			           VAR _to = _run1
			           VAR _x = 350
			           VAR _top = ROUND(MAX(60, 440 - (MAX(_from, _to)) / 1000 * 54.29), 1)
			           VAR _bot = ROUND(MAX(60, 440 - (MIN(_from, _to)) / 1000 * 54.29), 1)
			           RETURN "<rect x='" & (_x - 55) & "' y='" & _top & "' width='110' height='" & MAX(2, _bot - _top) & "' fill='url(%23s)' stroke='%230E0E0C' stroke-width='2'/>"
			               & "<line x1='" & (_x - 125) & "' y1='" & ROUND(MAX(60, 440 - (_from) / 1000 * 54.29), 1) & "' x2='" & (_x - 55) & "' y2='" & ROUND(MAX(60, 440 - (_from) / 1000 * 54.29), 1) & "' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='3 3'/>"
			               & "<rect x='" & (_x - 58) & "' y='" & (_top - 30) & "' width='116' height='22' fill='%23F4F4F0'/>"
			               & "<text x='" & _x & "' y='" & (_top - 13) & "' text-anchor='middle' font-size='15' font-weight='bold' fill='%230E0E0C'>" & IF(_to >= _from, "+", "-") & FORMAT(ABS(_to - _from) / 1000, "$0.00") & "B</text>"
			               & "<text x='" & _x & "' y='499' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(CALCULATE([Model Segment Growth], 'Segment'[Segment Code] = "PPA"), "+0%;-0%;0%"), "%", "%25") & "</text>"
			               & "<text x='" & _x & "' y='529' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(CALCULATE([Model Segment Margin], 'Segment'[Segment Code] = "PPA"), "0.0%"), "%", "%25") & "</text>")
			        & (VAR _from = _run1
			           VAR _to = _run2
			           VAR _x = 530
			           VAR _top = ROUND(MAX(60, 440 - (MAX(_from, _to)) / 1000 * 54.29), 1)
			           VAR _bot = ROUND(MAX(60, 440 - (MIN(_from, _to)) / 1000 * 54.29), 1)
			           RETURN "<rect x='" & (_x - 55) & "' y='" & _top & "' width='110' height='" & MAX(2, _bot - _top) & "' fill='url(%23s)' stroke='%230E0E0C' stroke-width='2'/>"
			               & "<line x1='" & (_x - 125) & "' y1='" & ROUND(MAX(60, 440 - (_from) / 1000 * 54.29), 1) & "' x2='" & (_x - 55) & "' y2='" & ROUND(MAX(60, 440 - (_from) / 1000 * 54.29), 1) & "' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='3 3'/>"
			               & "<rect x='" & (_x - 58) & "' y='" & (_top - 30) & "' width='116' height='22' fill='%23F4F4F0'/>"
			               & "<text x='" & _x & "' y='" & (_top - 13) & "' text-anchor='middle' font-size='15' font-weight='bold' fill='%230E0E0C'>" & IF(_to >= _from, "+", "-") & FORMAT(ABS(_to - _from) / 1000, "$0.00") & "B</text>"
			               & "<text x='" & _x & "' y='499' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(CALCULATE([Model Segment Growth], 'Segment'[Segment Code] = "SAT"), "+0%;-0%;0%"), "%", "%25") & "</text>"
			               & "<text x='" & _x & "' y='529' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(CALCULATE([Model Segment Margin], 'Segment'[Segment Code] = "SAT"), "0.0%"), "%", "%25") & "</text>")
			        & (VAR _from = _run2
			           VAR _to = _run3
			           VAR _x = 710
			           VAR _top = ROUND(MAX(60, 440 - (MAX(_from, _to)) / 1000 * 54.29), 1)
			           VAR _bot = ROUND(MAX(60, 440 - (MIN(_from, _to)) / 1000 * 54.29), 1)
			           RETURN "<rect x='" & (_x - 55) & "' y='" & _top & "' width='110' height='" & MAX(2, _bot - _top) & "' fill='url(%23s)' stroke='%230E0E0C' stroke-width='2'/>"
			               & "<line x1='" & (_x - 125) & "' y1='" & ROUND(MAX(60, 440 - (_from) / 1000 * 54.29), 1) & "' x2='" & (_x - 55) & "' y2='" & ROUND(MAX(60, 440 - (_from) / 1000 * 54.29), 1) & "' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='3 3'/>"
			               & "<rect x='" & (_x - 58) & "' y='" & (_top - 30) & "' width='116' height='22' fill='%23F4F4F0'/>"
			               & "<text x='" & _x & "' y='" & (_top - 13) & "' text-anchor='middle' font-size='15' font-weight='bold' fill='%230E0E0C'>" & IF(_to >= _from, "+", "-") & FORMAT(ABS(_to - _from) / 1000, "$0.00") & "B</text>"
			               & "<text x='" & _x & "' y='499' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(CALCULATE([Model Segment Growth], 'Segment'[Segment Code] = "CF"), "+0%;-0%;0%"), "%", "%25") & "</text>"
			               & "<text x='" & _x & "' y='529' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(CALCULATE([Model Segment Margin], 'Segment'[Segment Code] = "CF"), "0.0%"), "%", "%25") & "</text>")
			        & "<line x1='765' y1='" & ROUND(MAX(60, 440 - (_run3) / 1000 * 54.29), 1) & "' x2='835' y2='" & ROUND(MAX(60, 440 - (_run3) / 1000 * 54.29), 1) & "' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='3 3'/>"
			        & "<rect x='835' y='" & ROUND(MAX(60, 440 - (_op) / 1000 * 54.29), 1) & "' width='110' height='" & (440 - ROUND(MAX(60, 440 - (_op) / 1000 * 54.29), 1)) & "' fill='url(%23s)' stroke='%230E0E0C' stroke-width='3'/>"
			        & "<rect x='832' y='" & (ROUND(MAX(60, 440 - (_op) / 1000 * 54.29), 1) - 30) & "' width='116' height='22' fill='%23F4F4F0'/>"
			        & "<text x='890' y='" & (ROUND(MAX(60, 440 - (_op) / 1000 * 54.29), 1) - 13) & "' text-anchor='middle' font-size='15' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_op / 1000, "$0.00") & "B</text>"
			        & "<text x='890' y='499' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & FORMAT(_sales / 1000, "$0.0") & "B</text>"
			        & "<text x='890' y='529' text-anchor='middle' font-size='14' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_op, _sales), "0.0%"), "%", "%25") & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 81becbb3-351e-493e-804b-614a843f1d30

	/// The Stack: MODEL LAB ledger of modeled outputs against guidance and FY2025.
	measure 'SVG Model Lab Ledger' =
			VAR _sc = SELECTEDVALUE('Scenario'[Scenario], "Base")
			VAR _sa = [Selected Sales Adjustment]
			VAR _ma = [Selected Margin Adjustment Bps]
			VAR _sales = [Model Equipment Sales]
			VAR _op = [Model Equipment Operating Profit]
			VAR _ni = [Scenario Net Income]
			VAR _eps = [Projected EPS]
			VAR _op25 = CALCULATE(SUM('Annual Segments'[Operating Profit]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025)
			VAR _sales25 = CALCULATE(SUM('Annual Segments'[Net Sales]), REMOVEFILTERS('Annual Segments'), 'Annual Segments'[Fiscal Year] = 2025)
			VAR _tax = DIVIDE(-CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 6), CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 7) - CALCULATE(SUM('Earnings Bridge'[YTD FY26]), REMOVEFILTERS('Earnings Bridge'), 'Earnings Bridge'[Order] = 6))
			VAR _set = IF(_sa = 0 && _ma = 0, "the ", "your ") & LOWER(_sc) & " case"
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='496' viewBox='0 0 400 496' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & "<rect x='0' y='0' width='400' height='3' fill='%230E0E0C'/><rect x='0.75' y='38.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='42' width='8' height='8' fill='url(%23s)'/><text x='36' y='50' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<rect x='" & (400 - (LEN(FORMAT(_ni / 1000, "$0.00") & "B") * 30 - 5) - 34) & "' y='58' width='" & ((LEN(FORMAT(_ni / 1000, "$0.00") & "B") * 30 - 5) + 34) & "' height='50' fill='url(%23g)'/>"
			        & "<rect x='" & (388 - (LEN(FORMAT(_ni / 1000, "$0.00") & "B") * 30 - 5) - 6) & "' y='62' width='" & ((LEN(FORMAT(_ni / 1000, "$0.00") & "B") * 30 - 5) + 12) & "' height='43' fill='%23F4F4F0'/>"
			        & "<text x='0' y='26' font-size='15' font-weight='bold' fill='%230E0E0C'>" & "Net income, FY2026, " & LOWER(_sc) & " case" & "</text>"
			        & "<text x='68' y='51' font-size='13' fill='%230E0E0C'>" & "EPS " & FORMAT(_eps, "$0.00") & " on 269.8M diluted shares" & "</text>"
			        & "<g fill='%230E0E0C'>" & (
			        VAR _ptml0 = FORMAT(_ni / 1000, "$0.00") & "B"
			        VAR _pxml0 = (388 - (LEN(FORMAT(_ni / 1000, "$0.00") & "B") * 30 - 5))
			        VAR _pyml0 = 66
			        RETURN
			            CONCATENATEX(
			                GENERATE(
			                    SELECTCOLUMNS(GENERATESERIES(1, LEN(_ptml0), 1), "ciml0", [Value]),
			                    VAR _bits = LOOKUPVALUE('Glyphs'[Bits], 'Glyphs'[Code], UNICODE(MID(_ptml0, [ciml0], 1)), REPT("0", 35))
			                    RETURN FILTER(SELECTCOLUMNS(GENERATESERIES(0, 34, 1), "cellml0", [Value]), MID(_bits, [cellml0] + 1, 1) = "1")
			                ),
			                "<rect x='" & (_pxml0 + ([ciml0] - 1) * 30 + MOD([cellml0], 5) * 5) & "' y='" & (_pyml0 + INT([cellml0] / 5) * 5) & "' width='5' height='5'/>",
			                ""
			            )
			    ) & "</g>"
			        & "<rect x='0' y='112' width='400' height='1' fill='%230E0E0C'/><rect x='250' y='122' width='150' height='56' fill='url(%23g)'/><rect x='0.75' y='146.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='150' width='8' height='8' fill='url(%23s)'/><text x='36' y='158' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<text x='0' y='136' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Equipment sales, FY2026" & "</text>"
			        & "<text x='68' y='159' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_sales, _sales25) - 1, "+0%;-0%;0%"), "%", "%25") & " on FY2025" & "</text>"
			        & "<text x='390' y='157' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C' stroke='%23F4F4F0' stroke-width='7' stroke-linejoin='round' paint-order='stroke'>" & FORMAT(_sales / 1000, "$0.0") & "B" & "</text>"
			        & "<rect x='0' y='188' width='400' height='1' fill='%230E0E0C'/><rect x='250' y='198' width='150' height='56' fill='url(%23g)'/><rect x='0.75' y='222.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='226' width='8' height='8' fill='url(%23s)'/><text x='36' y='234' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<text x='0' y='212' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Operating profit, FY2026" & "</text>"
			        & "<text x='68' y='235' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_op, _sales), "0.0%"), "%", "%25") & " margin" & "</text>"
			        & "<text x='390' y='233' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C' stroke='%23F4F4F0' stroke-width='7' stroke-linejoin='round' paint-order='stroke'>" & FORMAT(_op / 1000, "$0.00") & "B" & "</text>"
			        & "<rect x='0' y='264' width='400' height='1' fill='%230E0E0C'/><rect x='0' y='298' width='72' height='16' fill='%23367C2B'/><text x='36' y='310' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='288' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net income guidance, FY2026" & "</text>"
			        & "<text x='80' y='311' font-size='12' fill='%230E0E0C'>" & "Management's range" & "</text>"
			        & "<text x='400' y='309' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "$4.75B-5.00B" & "</text>"
			        & "<rect x='0' y='340' width='400' height='1' fill='%230E0E0C'/><rect x='0' y='374' width='54' height='16' fill='%230E0E0C'/><text x='27' y='386' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='364' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Operating profit, FY2025" & "</text>"
			        & "<text x='62' y='387' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT(DIVIDE(_op25, _sales25), "0.0%"), "%", "%25") & " margin" & "</text>"
			        & "<text x='400' y='385' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT(_op25 / 1000, "$0.00") & "B" & "</text>"
			        & "<rect x='0' y='416' width='400' height='1' fill='%230E0E0C'/><rect x='250' y='426' width='150' height='56' fill='url(%23g)'/><rect x='0.75' y='450.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='454' width='8' height='8' fill='url(%23s)'/><text x='36' y='462' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<text x='0' y='440' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Tax rate on your changes" & "</text>"
			        & "<text x='68' y='463' font-size='12' fill='%230E0E0C'>" & "FY2026 effective rate, to Q3" & "</text>"
			        & "<text x='390' y='461' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C' stroke='%23F4F4F0' stroke-width='7' stroke-linejoin='round' paint-order='stroke'>" & SUBSTITUTE(FORMAT(_tax, "0.0%"), "%", "%25") & "</text>"
			        & "<rect x='0' y='493' width='400' height='2' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 608a869e-f3e1-436a-83f9-c590656dbc33

	/// The Stack: painted sales-adjustment cells; the transparent slicer sits on top.
	measure 'SVG Sales Strip' =
			VAR _sel = [Selected Sales Adjustment]
			VAR _steps = ADDCOLUMNS(ALL('Sales Adjustment'[Sales Adjustment]), "@i", RANKX(ALL('Sales Adjustment'[Sales Adjustment]), 'Sales Adjustment'[Sales Adjustment], , ASC) - 1, "@eps", CALCULATE([Projected EPS]))
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='480' height='80' viewBox='0 0 480 80' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & CONCATENATEX(_steps,
			            VAR _x = [@i] * 96
			            VAR _on = 'Sales Adjustment'[Sales Adjustment] = _sel
			            VAR _ink = IF(_on, "%23F4F4F0", "%230E0E0C")
			            RETURN "<rect x='" & (_x + 1.5) & "' y='1.5' width='88' height='77' fill='" & IF(_on, "%230E0E0C", "%23F4F4F0") & "' stroke='%230E0E0C' stroke-width='3'/>"
			                & IF(_on, "", "<rect x='" & (_x + 8) & "' y='60' width='72' height='12' fill='url(%23s)'/>")
			                & "<text x='" & (_x + 45.5) & "' y='28' text-anchor='middle' font-size='17' font-weight='bold' fill='" & _ink & "'>" & SUBSTITUTE(FORMAT('Sales Adjustment'[Sales Adjustment], "+0%;-0%;0%"), "%", "%25") & "</text>"
			                & "<text x='" & (_x + 45.5) & "' y='52' text-anchor='middle' font-size='14' fill='" & _ink & "'>" & FORMAT([@eps], "$0.00") & "</text>",
			            "", 'Sales Adjustment'[Sales Adjustment], ASC)
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: ae4ce9fd-d0b2-4d44-9a59-5452bf85e77a

	/// The Stack: painted operating-margin adjustment cells; the transparent slicer sits on top.
	measure 'SVG Margin Strip' =
			VAR _sel = [Selected Margin Adjustment Bps]
			VAR _steps = ADDCOLUMNS(ALL('Margin Adjustment'[Margin Adjustment (bps)]), "@i", RANKX(ALL('Margin Adjustment'[Margin Adjustment (bps)]), 'Margin Adjustment'[Margin Adjustment (bps)], , ASC) - 1, "@eps", CALCULATE([Projected EPS]))
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='500' height='80' viewBox='0 0 500 80' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & CONCATENATEX(_steps,
			            VAR _x = [@i] * 100
			            VAR _on = 'Margin Adjustment'[Margin Adjustment (bps)] = _sel
			            VAR _ink = IF(_on, "%23F4F4F0", "%230E0E0C")
			            RETURN "<rect x='" & (_x + 1.5) & "' y='1.5' width='92' height='77' fill='" & IF(_on, "%230E0E0C", "%23F4F4F0") & "' stroke='%230E0E0C' stroke-width='3'/>"
			                & IF(_on, "", "<rect x='" & (_x + 8) & "' y='60' width='76' height='12' fill='url(%23s)'/>")
			                & "<text x='" & (_x + 47.5) & "' y='28' text-anchor='middle' font-size='15' font-weight='bold' fill='" & _ink & "'>" & FORMAT('Margin Adjustment'[Margin Adjustment (bps)], "+0;-0;0") & "bp" & "</text>"
			                & "<text x='" & (_x + 47.5) & "' y='52' text-anchor='middle' font-size='14' fill='" & _ink & "'>" & FORMAT([@eps], "$0.00") & "</text>",
			            "", 'Margin Adjustment'[Margin Adjustment (bps)], ASC)
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: e2bcd187-feb4-4074-bac8-996ca9087d98

	/// The Stack: SOURCES card header.
	measure 'SVG Header SOURCES' =
			VAR _price = [Latest Price]
			VAR _date = [Latest Price Date]
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='96' viewBox='0 0 1420 96' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><g fill='%230E0E0C'><rect x='10' y='8' width='10' height='10'/><rect x='20' y='8' width='10' height='10'/><rect x='30' y='8' width='10' height='10'/><rect x='40' y='8' width='10' height='10'/><rect x='0' y='18' width='10' height='10'/><rect x='0' y='28' width='10' height='10'/><rect x='10' y='38' width='10' height='10'/><rect x='20' y='38' width='10' height='10'/><rect x='30' y='38' width='10' height='10'/><rect x='40' y='48' width='10' height='10'/><rect x='40' y='58' width='10' height='10'/><rect x='0' y='68' width='10' height='10'/><rect x='10' y='68' width='10' height='10'/><rect x='20' y='68' width='10' height='10'/><rect x='30' y='68' width='10' height='10'/><rect x='70' y='8' width='10' height='10'/><rect x='80' y='8' width='10' height='10'/><rect x='90' y='8' width='10' height='10'/><rect x='60' y='18' width='10' height='10'/><rect x='100' y='18' width='10' height='10'/><rect x='60' y='28' width='10' height='10'/><rect x='100' y='28' width='10' height='10'/><rect x='60' y='38' width='10' height='10'/><rect x='100' y='38' width='10' height='10'/><rect x='60' y='48' width='10' height='10'/><rect x='100' y='48' width='10' height='10'/><rect x='60' y='58' width='10' height='10'/><rect x='100' y='58' width='10' height='10'/><rect x='70' y='68' width='10' height='10'/><rect x='80' y='68' width='10' height='10'/><rect x='90' y='68' width='10' height='10'/><rect x='120' y='8' width='10' height='10'/><rect x='160' y='8' width='10' height='10'/><rect x='120' y='18' width='10' height='10'/><rect x='160' y='18' width='10' height='10'/><rect x='120' y='28' width='10' height='10'/><rect x='160' y='28' width='10' height='10'/><rect x='120' y='38' width='10' height='10'/><rect x='160' y='38' width='10' height='10'/><rect x='120' y='48' width='10' height='10'/><rect x='160' y='48' width='10' height='10'/><rect x='120' y='58' width='10' height='10'/><rect x='160' y='58' width='10' height='10'/><rect x='130' y='68' width='10' height='10'/><rect x='140' y='68' width='10' height='10'/><rect x='150' y='68' width='10' height='10'/><rect x='180' y='8' width='10' height='10'/><rect x='190' y='8' width='10' height='10'/><rect x='200' y='8' width='10' height='10'/><rect x='210' y='8' width='10' height='10'/><rect x='180' y='18' width='10' height='10'/><rect x='220' y='18' width='10' height='10'/><rect x='180' y='28' width='10' height='10'/><rect x='220' y='28' width='10' height='10'/><rect x='180' y='38' width='10' height='10'/><rect x='190' y='38' width='10' height='10'/><rect x='200' y='38' width='10' height='10'/><rect x='210' y='38' width='10' height='10'/><rect x='180' y='48' width='10' height='10'/><rect x='200' y='48' width='10' height='10'/><rect x='180' y='58' width='10' height='10'/><rect x='210' y='58' width='10' height='10'/><rect x='180' y='68' width='10' height='10'/><rect x='220' y='68' width='10' height='10'/><rect x='250' y='8' width='10' height='10'/><rect x='260' y='8' width='10' height='10'/><rect x='270' y='8' width='10' height='10'/><rect x='240' y='18' width='10' height='10'/><rect x='280' y='18' width='10' height='10'/><rect x='240' y='28' width='10' height='10'/><rect x='240' y='38' width='10' height='10'/><rect x='240' y='48' width='10' height='10'/><rect x='240' y='58' width='10' height='10'/><rect x='280' y='58' width='10' height='10'/><rect x='250' y='68' width='10' height='10'/><rect x='260' y='68' width='10' height='10'/><rect x='270' y='68' width='10' height='10'/><rect x='300' y='8' width='10' height='10'/><rect x='310' y='8' width='10' height='10'/><rect x='320' y='8' width='10' height='10'/><rect x='330' y='8' width='10' height='10'/><rect x='340' y='8' width='10' height='10'/><rect x='300' y='18' width='10' height='10'/><rect x='300' y='28' width='10' height='10'/><rect x='300' y='38' width='10' height='10'/><rect x='310' y='