		lineageTag: 0325776b-d20d-410c-9cda-592c88d1de93

	/// The Stack: PULSE finding, the author's sentence over the latest quarter's segment growth.
	measure 'SVG Pulse Finding' =
			VAR _key = [Latest Period Key]
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='84' viewBox='0 0 1420 84' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & "<text x='0' y='30' font-size='24' font-weight='bold' fill='%230E0E0C'>Large ag is back to shrinking. Small ag and construction still grow, slower than they did in Q1.</text>"
			        & "<text x='0' y='70' font-size='22' fill='%230E0E0C'>" & [Latest Period Label] & " sales against the same quarter last year: PPA " & SUBSTITUTE(FORMAT(LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], _key, 'Quarterly Segments'[Segment Code], "PPA"), "+0%;-0%;0%"), "%", "%25") & ", SAT " & SUBSTITUTE(FORMAT(LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], _key, 'Quarterly Segments'[Segment Code], "SAT"), "+0%;-0%;0%"), "%", "%25") & ", C&amp;F " & SUBSTITUTE(FORMAT(LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], _key, 'Quarterly Segments'[Segment Code], "CF"), "+0%;-0%;0%"), "%", "%25") & ".</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 8c1f4ebb-c133-4808-9027-cb246a5fbf03

	/// The Stack: segment sales growth vs a year earlier over the last seven fiscal quarters.
	measure 'SVG Pulse Divergence' =
			VAR _last = TOPN(7, ALL('Period'[Period Key], 'Period'[Period Sort], 'Period'[Period Label]), 'Period'[Period Sort], DESC)
			VAR _minSort = MINX(_last, 'Period'[Period Sort])
			VAR _maxKey = MAXX(_last, 'Period'[Period Key])
			VAR _pts = ADDCOLUMNS(_last, "@x", 70 + ('Period'[Period Sort] - _minSort) * 125)
			VAR _vPPA = LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], _maxKey, 'Quarterly Segments'[Segment Code], "PPA")
			VAR _vSAT = LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], _maxKey, 'Quarterly Segments'[Segment Code], "SAT")
			VAR _vCF = LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], _maxKey, 'Quarterly Segments'[Segment Code], "CF")
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='960' height='620' viewBox='0 0 960 620' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><text x='0' y='22' font-size='16' font-weight='bold' fill='%230E0E0C'>Segment sales growth against the same quarter last year</text><g fill='none' stroke='%230E0E0C'><line x1='0' y1='44' x2='34' y2='44' stroke-width='5'/><line x1='270' y1='44' x2='304' y2='44' stroke-width='3' stroke-dasharray='14 7'/><line x1='510' y1='44' x2='544' y2='44' stroke-width='3' stroke-dasharray='4 6'/></g><g font-size='13' fill='%230E0E0C'><text x='42' y='49'>PPA Production &amp; Precision Ag</text><text x='312' y='49'>SAT Small Ag &amp; Turf</text><text x='552' y='49'>C&amp;F Construction &amp; Forestry</text></g><line x1='70' y1='100' x2='820' y2='100' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='105' text-anchor='end' font-size='13' fill='%230E0E0C'>+40%25</text><line x1='70' y1='202.5' x2='820' y2='202.5' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='207.5' text-anchor='end' font-size='13' fill='%230E0E0C'>+20%25</text><line x1='70' y1='407.5' x2='820' y2='407.5' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='412.5' text-anchor='end' font-size='13' fill='%230E0E0C'>-20%25</text><line x1='70' y1='510' x2='820' y2='510' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='60' y='515' text-anchor='end' font-size='13' fill='%230E0E0C'>-40%25</text><rect x='70' y='304' width='750' height='3' fill='%230E0E0C'/><text x='60' y='310' text-anchor='end' font-size='13' fill='%230E0E0C'>0</text><text x='78' y='297' font-size='12' fill='%230E0E0C'>growing</text><text x='78' y='323' font-size='12' fill='%230E0E0C'>shrinking</text>"
			        & "<polyline fill='none' stroke='%230E0E0C' stroke-width='5' points='" & CONCATENATEX(_pts, [@x] & "," & ROUND(MAX(100, MIN(510, 305 - LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA") * 512.5)), 1), " ", [@x], ASC) & "'/>"
			        & CONCATENATEX(_pts, "<rect x='" & ([@x] - 4) & "' y='" & (ROUND(MAX(100, MIN(510, 305 - LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "PPA") * 512.5)), 1) - 4) & "' width='8' height='8' fill='%230E0E0C'/>", "")
			        & "<text x='834' y='" & (ROUND(MAX(100, MIN(510, 305 - _vPPA * 512.5)), 1) + 5) & "' font-size='15' font-weight='bold' fill='%230E0E0C'>PPA " & SUBSTITUTE(FORMAT(_vPPA, "+0%;-0%;0%"), "%", "%25") & "</text>"
			        & "<polyline fill='none' stroke='%230E0E0C' stroke-width='3' stroke-dasharray='14 7' points='" & CONCATENATEX(_pts, [@x] & "," & ROUND(MAX(100, MIN(510, 305 - LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT") * 512.5)), 1), " ", [@x], ASC) & "'/>"
			        & CONCATENATEX(_pts, "<rect x='" & ([@x] - 4) & "' y='" & (ROUND(MAX(100, MIN(510, 305 - LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "SAT") * 512.5)), 1) - 4) & "' width='8' height='8' fill='%230E0E0C'/>", "")
			        & "<text x='834' y='" & (ROUND(MAX(100, MIN(510, 305 - _vSAT * 512.5)), 1) + 5) & "' font-size='15' font-weight='bold' fill='%230E0E0C'>SAT " & SUBSTITUTE(FORMAT(_vSAT, "+0%;-0%;0%"), "%", "%25") & "</text>"
			        & "<polyline fill='none' stroke='%230E0E0C' stroke-width='3' stroke-dasharray='4 6' points='" & CONCATENATEX(_pts, [@x] & "," & ROUND(MAX(100, MIN(510, 305 - LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "CF") * 512.5)), 1), " ", [@x], ASC) & "'/>"
			        & CONCATENATEX(_pts, "<rect x='" & ([@x] - 4) & "' y='" & (ROUND(MAX(100, MIN(510, 305 - LOOKUPVALUE('Quarterly Segments'[Sales YoY %], 'Quarterly Segments'[Period Key], 'Period'[Period Key], 'Quarterly Segments'[Segment Code], "CF") * 512.5)), 1) - 4) & "' width='8' height='8' fill='%230E0E0C'/>", "")
			        & "<text x='834' y='" & (ROUND(MAX(100, MIN(510, 305 - _vCF * 512.5)), 1) + 5) & "' font-size='15' font-weight='bold' fill='%230E0E0C'>C&amp;F " & SUBSTITUTE(FORMAT(_vCF, "+0%;-0%;0%"), "%", "%25") & "</text>"
			        & CONCATENATEX(_pts, "<text x='" & [@x] & "' y='544' text-anchor='middle' font-size='13' fill='%230E0E0C'>" & 'Period'[Period Label] & "</text>", "", [@x], ASC)
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 11c723f1-69eb-4dc1-be21-3c3f1e2ca5c3

	/// The Stack: PULSE ledger of latest-quarter actuals, guidance and price.
	measure 'SVG Pulse Ledger' =
			VAR _period = [Latest Period Label]
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='440' height='572' viewBox='0 0 440 572' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & "<rect x='0' y='0' width='440' height='3' fill='%230E0E0C'/><rect x='0' y='38' width='54' height='16' fill='%230E0E0C'/><text x='27' y='50' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='26' font-size='15' font-weight='bold' fill='%230E0E0C'>" & "Net sales and revenues, " & _period & "</text>"
			        & "<text x='62' y='51' font-size='13' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT([Latest Revenue YoY], "+0%;-0%;0%"), "%", "%25") & " vs a year earlier" & "</text>"
			        & "<g fill='%230E0E0C'>" & (
			        VAR _ptpl0 = "$" & FORMAT([Latest Revenue], "#,##0") & "M"
			        VAR _pxpl0 = (440 - (LEN("$" & FORMAT([Latest Revenue], "#,##0") & "M") * 30 - 5))
			        VAR _pypl0 = 66
			        RETURN
			            CONCATENATEX(
			                GENERATE(
			                    SELECTCOLUMNS(GENERATESERIES(1, LEN(_ptpl0), 1), "cipl0", [Value]),
			                    VAR _bits = LOOKUPVALUE('Glyphs'[Bits], 'Glyphs'[Code], UNICODE(MID(_ptpl0, [cipl0], 1)), REPT("0", 35))
			                    RETURN FILTER(SELECTCOLUMNS(GENERATESERIES(0, 34, 1), "cellpl0", [Value]), MID(_bits, [cellpl0] + 1, 1) = "1")
			                ),
			                "<rect x='" & (_pxpl0 + ([cipl0] - 1) * 30 + MOD([cellpl0], 5) * 5) & "' y='" & (_pypl0 + INT([cellpl0] / 5) * 5) & "' width='5' height='5'/>",
			                ""
			            )
			    ) & "</g>"
			        & "<rect x='0' y='112' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='146' width='54' height='16' fill='%230E0E0C'/><text x='27' y='158' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='136' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net income, " & _period & "</text>"
			        & "<text x='62' y='159' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT([Latest Net Income YoY], "+0%;-0%;0%"), "%", "%25") & " vs a year earlier" & "</text>"
			        & "<text x='440' y='157' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT([Latest Net Income], "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='188' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='222' width='54' height='16' fill='%230E0E0C'/><text x='27' y='234' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='212' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Diluted EPS, " & _period & "</text>"
			        & "<text x='62' y='235' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT([Latest EPS YoY], "+0%;-0%;0%"), "%", "%25") & " vs a year earlier" & "</text>"
			        & "<text x='440' y='233' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT([Latest EPS], "$0.00") & "</text>"
			        & "<rect x='0' y='264' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='298' width='54' height='16' fill='%230E0E0C'/><text x='27' y='310' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='288' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Equipment operating profit, " & _period & "</text>"
			        & "<text x='62' y='311' font-size='12' fill='%230E0E0C'>" & "PPA $" & FORMAT(CALCULATE(SUM('Earnings Bridge'[Q3 FY26]), 'Earnings Bridge'[Order] = 1), "#,##0") & "M, SAT $" & FORMAT(CALCULATE(SUM('Earnings Bridge'[Q3 FY26]), 'Earnings Bridge'[Order] = 2), "#,##0") & "M, C&amp;F $" & FORMAT(CALCULATE(SUM('Earnings Bridge'[Q3 FY26]), 'Earnings Bridge'[Order] = 3), "#,##0") & "M" & "</text>"
			        & "<text x='440' y='309' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(CALCULATE(SUM('Earnings Bridge'[Q3 FY26]), 'Earnings Bridge'[Order] <= 3), "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='340' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='374' width='54' height='16' fill='%230E0E0C'/><text x='27' y='386' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='364' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net income, fiscal 2026 to date" & "</text>"
			        & "<text x='62' y='387' font-size='12' fill='%230E0E0C'>" & "First three quarters" & "</text>"
			        & "<text x='440' y='385' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT(CALCULATE(SUM('Earnings Bridge'[YTD FY26]), 'Earnings Bridge'[Kind] = "Total"), "#,##0") & "M" & "</text>"
			        & "<rect x='0' y='416' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='450' width='72' height='16' fill='%23367C2B'/><text x='36' y='462' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>GUIDANCE</text>"
			        & "<text x='0' y='440' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Net income guidance, FY2026" & "</text>"
			        & "<text x='80' y='463' font-size='12' fill='%230E0E0C'>" & "Management's range" & "</text>"
			        & "<text x='440' y='461' text-anchor='end' font-size='22' font-weight='bold' fill='%23367C2B'>" & "$4.75B-5.00B" & "</text>"
			        & "<rect x='0' y='492' width='440' height='1' fill='%230E0E0C'/><rect x='0' y='526' width='54' height='16' fill='%230E0E0C'/><text x='27' y='538' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='516' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Share price, " & FORMAT([Latest Price Date], "d mmm yyyy") & "</text>"
			        & "<text x='62' y='539' font-size='12' fill='%230E0E0C'>" & FORMAT([Trailing PE], "0.0") & "x the last four quarters of EPS" & "</text>"
			        & "<text x='440' y='537' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT([Latest Price], "$0.00") & "</text>"
			        & "<rect x='0' y='569' width='440' height='2' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: cc61795a-0de7-430c-a3d6-bf4352b4db9e

	/// The Stack: live VALUATION finding as plain text (author to rewrite the words, see _brief/VOICE_REWRITES.md N1).
	measure 'Valuation Finding' =
			VAR _price = [Latest Price]
			VAR _pe = [Selected PE]
			VAR _sc = LOWER(SELECTEDVALUE('Scenario'[Scenario], "Base"))
			VAR _eps = [Projected EPS]
			VAR _need = DIVIDE(_price, _pe)
			VAR _case = IF([Selected Sales Adjustment] = 0 && [Selected Margin Adjustment Bps] = 0, "the ", "your ") & _sc & " case"
			VAR _l1 = "At " & FORMAT(_price, "$#,##0.00") & ", you're paying " & FORMAT(DIVIDE(_price, _eps), "0.0") & "x the " & FORMAT(_eps, "$0.00") & " a share Deere earns in " & _case & " this year."
			VAR _gap = FORMAT(ABS(DIVIDE(_need, _eps) - 1), "0%") & IF(_need >= _eps, " above ", " below ")
			VAR _l2 = "To justify " & FORMAT(_pe, "0") & "x, Deere has to earn " & FORMAT(_need, "$0.00") & " a share, " & _gap & _case & ". Its record EPS gets you to " & FORMAT(DIVIDE(_price, [Peak EPS]), "0.0") & "x."
			RETURN _l1 & " " & _l2
		displayFolder: The Stack
		lineageTag: 6cf738d5-e923-4f15-b7aa-3a0fb97faf40

	/// The Stack: the live VALUATION finding set on two lines.
	measure 'SVG Valuation Finding' =
			VAR _price = [Latest Price]
			VAR _pe = [Selected PE]
			VAR _sc = LOWER(SELECTEDVALUE('Scenario'[Scenario], "Base"))
			VAR _eps = [Projected EPS]
			VAR _need = DIVIDE(_price, _pe)
			VAR _case = IF([Selected Sales Adjustment] = 0 && [Selected Margin Adjustment Bps] = 0, "the ", "your ") & _sc & " case"
			VAR _l1 = "At " & FORMAT(_price, "$#,##0.00") & ", you're paying " & FORMAT(DIVIDE(_price, _eps), "0.0") & "x the " & FORMAT(_eps, "$0.00") & " a share Deere earns in " & _case & " this year."
			VAR _gap = FORMAT(ABS(DIVIDE(_need, _eps) - 1), "0%") & IF(_need >= _eps, " above ", " below ")
			VAR _l2 = "To justify " & FORMAT(_pe, "0") & "x, Deere has to earn " & FORMAT(_need, "$0.00") & " a share, " & _gap & _case & ". Its record EPS gets you to " & FORMAT(DIVIDE(_price, [Peak EPS]), "0.0") & "x."
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1420' height='84' viewBox='0 0 1420 84' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & "<text x='0' y='30' font-size='24' font-weight='bold' fill='%230E0E0C'>" & _l1 & "</text>"
			        & "<text x='0' y='70' font-size='22' fill='%230E0E0C'>" & SUBSTITUTE(_l2, "%", "%25") & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 8083b93e-da3d-4c0b-906c-a3697a60059a

	/// The Stack: EPS the latest close requires at each P/E, against the FY2023 record, guidance and scenarios.
	measure 'SVG Valuation Ladder' =
			VAR _price = [Latest Price]
			VAR _pe = [Selected PE]
			VAR _sc = SELECTEDVALUE('Scenario'[Scenario], "Base")
			VAR _epsSel = [Projected EPS]
			VAR _bear = CALCULATE(DIVIDE(MAX('Scenario'[Net Income]), 269.8), REMOVEFILTERS('Scenario'), 'Scenario'[Scenario] = "Bear")
			VAR _bull = CALCULATE(DIVIDE(MAX('Scenario'[Net Income]), 269.8), REMOVEFILTERS('Scenario'), 'Scenario'[Scenario] = "Bull")
			VAR _gLo = 4750 / 269.8
			VAR _gHi = 5000 / 269.8
			VAR _peak = [Peak EPS]
			VAR _peX = ROUND(MAX(80, MIN(860, (80 + (DIVIDE(_price, _peak) - 14) * 27.857))), 1)
			VAR _scX = ROUND(MAX(80, MIN(860, (80 + (DIVIDE(_price, _epsSel) - 14) * 27.857))), 1)
			VAR _selX = ROUND((80 + (_pe - 14) * 27.857), 1)
			VAR _selY = ROUND(MAX(60, MIN(460, (460 - ((DIVIDE(_price, _pe)) - 10) * 11.4286))), 1)
			VAR _boxX = IF(_selX > 680, _selX - 250, _selX + 26)
			VAR _boxY = _selY - 48
			VAR _closeX = ROUND((80 + (16 - 14) * 27.857), 1)
			VAR _closeY = ROUND(MAX(60, MIN(460, (460 - ((DIVIDE(_price, 16)) - 10) * 11.4286))), 1)
			VAR _curve = CONCATENATEX(GENERATESERIES(15.5, 42, 0.5), ROUND((80 + ([Value] - 14) * 27.857), 1) & "," & ROUND(MAX(60, MIN(460, (460 - ((DIVIDE(_price, [Value])) - 10) * 11.4286))), 1), " ", [Value], ASC)
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1000' height='540' viewBox='0 0 1000 540' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs><text x='0' y='22' font-size='16' font-weight='bold' fill='%230E0E0C'>EPS Deere has to earn at each P/E</text><line x1='80' y1='345.714' x2='860' y2='345.714' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='70' y='350.714' text-anchor='end' font-size='13' fill='%230E0E0C'>$20</text><line x1='80' y1='231.428' x2='860' y2='231.428' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='70' y='236.428' text-anchor='end' font-size='13' fill='%230E0E0C'>$30</text><line x1='80' y1='117.142' x2='860' y2='117.142' stroke='%230E0E0C' stroke-width='1' stroke-dasharray='2 5'/><text x='70' y='122.142' text-anchor='end' font-size='13' fill='%230E0E0C'>$40</text><text x='70' y='465' text-anchor='end' font-size='13' fill='%230E0E0C'>$10</text><rect x='80' y='459' width='780' height='3' fill='%230E0E0C'/><rect x='134.714' y='460' width='2' height='8' fill='%230E0E0C'/><text x='135.714' y='486' text-anchor='middle' font-size='13' fill='%230E0E0C'>16x</text><rect x='246.142' y='460' width='2' height='8' fill='%230E0E0C'/><text x='247.142' y='486' text-anchor='middle' font-size='13' fill='%230E0E0C'>20x</text><rect x='357.57' y='460' width='2' height='8' fill='%230E0E0C'/><text x='358.57' y='486' text-anchor='middle' font-size='13' fill='%230E0E0C'>24x</text><rect x='468.998' y='460' width='2' height='8' fill='%230E0E0C'/><text x='469.998' y='486' text-anchor='middle' font-size='13' fill='%230E0E0C'>28x</text><rect x='580.4259999999999' y='460' width='2' height='8' fill='%230E0E0C'/><text x='581.4259999999999' y='486' text-anchor='middle' font-size='13' fill='%230E0E0C'>32x</text><rect x='691.854' y='460' width='2' height='8' fill='%230E0E0C'/><text x='692.854' y='486' text-anchor='middle' font-size='13' fill='%230E0E0C'>36x</text><rect x='803.2819999999999' y='460' width='2' height='8' fill='%230E0E0C'/><text x='804.2819999999999' y='486' text-anchor='middle' font-size='13' fill='%230E0E0C'>40x</text>"
			        & "<rect x='80' y='" & ROUND((460 - ((_bull) - 10) * 11.4286), 1) & "' width='780' height='" & ROUND((_bull - _bear) * 11.4286, 1) & "' fill='url(%23s)'/>"
			        & "<rect x='80' y='" & ROUND((460 - ((_bull) - 10) * 11.4286), 1) & "' width='780' height='1' fill='%230E0E0C'/><rect x='80' y='" & ROUND((460 - ((_bear) - 10) * 11.4286) - 1, 1) & "' width='780' height='1' fill='%230E0E0C'/>"
			        & "<rect x='870' y='" & ROUND((460 - ((_gHi) - 10) * 11.4286) - 1.5, 1) & "' width='4' height='" & ROUND((_gHi - _gLo) * 11.4286 + 3, 1) & "' fill='%23367C2B'/>"
			        & "<rect x='864' y='" & ROUND((460 - ((_gHi) - 10) * 11.4286) - 1.5, 1) & "' width='16' height='3' fill='%23367C2B'/><rect x='864' y='" & ROUND((460 - ((_gLo) - 10) * 11.4286) - 1.5, 1) & "' width='16' height='3' fill='%23367C2B'/>"
			        & "<text x='886' y='" & ROUND((460 - ((_gHi) - 10) * 11.4286) - 6, 1) & "' font-size='14' font-weight='bold' fill='%23367C2B'>Guidance</text>"
			        & "<text x='886' y='" & ROUND((460 - ((_gLo) - 10) * 11.4286) + 16, 1) & "' font-size='13' font-weight='bold' fill='%23367C2B'>" & FORMAT(_gLo, "$0.00") & "-" & FORMAT(_gHi, "0.00") & "</text>"
			        & "<rect x='80' y='" & ROUND((460 - ((_peak) - 10) * 11.4286) - 1.5, 1) & "' width='780' height='3' fill='%230E0E0C'/>"
			        & "<text x='860' y='" & ROUND((460 - ((_peak) - 10) * 11.4286) - 10, 1) & "' text-anchor='end' font-size='13' font-weight='bold' fill='%230E0E0C'>FY" & [Peak EPS Year] & " record, " & FORMAT(_peak, "$0.00") & "</text>"
			        & "<polyline fill='none' stroke='%230E0E0C' stroke-width='4' points='" & _curve & "'/>"
			        & "<rect x='" & (_closeX - 5) & "' y='" & (_closeY - 5) & "' width='10' height='10' fill='%230E0E0C'/>"
			        & "<text x='" & (_closeX + 14) & "' y='" & (_closeY - 6) & "' font-size='14' font-weight='bold' fill='%230E0E0C'>EPS needed at today's " & FORMAT(_price, "$0.00") & "</text>"
			        & "<line x1='" & _peX & "' y1='" & ROUND((460 - ((_peak) - 10) * 11.4286), 1) & "' x2='" & _peX & "' y2='500' stroke='%230E0E0C' stroke-width='2' stroke-dasharray='3 4'/>"
			        & "<line x1='" & _scX & "' y1='" & ROUND((460 - ((_epsSel) - 10) * 11.4286), 1) & "' x2='" & _scX & "' y2='500' stroke='%230E0E0C' stroke-width='2' stroke-dasharray='3 4'/>"
			        & "<rect x='86' y='" & ROUND((460 - ((_bear) - 10) * 11.4286) + 6, 1) & "' width='246' height='18' fill='%23F4F4F0'/>"
			        & "<text x='90' y='" & ROUND((460 - ((_bear) - 10) * 11.4286) + 20, 1) & "' font-size='13' fill='%230E0E0C'>My bear-to-bull range</text>"
			        & "<rect x='" & (_peX - 7) & "' y='" & ROUND((460 - ((_peak) - 10) * 11.4286) - 7, 1) & "' width='14' height='14' fill='%230E0E0C'/>"
			        & "<rect x='" & (_scX - 7) & "' y='" & ROUND((460 - ((_epsSel) - 10) * 11.4286) - 7, 1) & "' width='14' height='14' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='3'/>"
			        & "<rect x='" & (MAX(150, MIN(850, _peX)) - 150) & "' y='502' width='300' height='30' fill='%23F4F4F0'/>"
			        & "<text x='" & MAX(150, MIN(850, _peX)) & "' y='523' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>" & FORMAT(DIVIDE(_price, _peak), "0.0") & "x = FY" & [Peak EPS Year] & " record EPS" & "</text>"
			        & "<rect x='" & (MAX(150, MIN(850, _scX)) - 150) & "' y='502' width='300' height='30' fill='%23F4F4F0'/>"
			        & "<text x='" & MAX(150, MIN(850, _scX)) & "' y='523' text-anchor='middle' font-size='14' font-weight='bold' fill='%230E0E0C'>" & FORMAT(DIVIDE(_price, _epsSel), "0.0") & "x = " & LOWER(_sc) & "-case FY2026 EPS" & "</text>"
			        & "<line x1='" & _selX & "' y1='" & _selY & "' x2='" & IF(_selX > 680, _boxX + 224, _boxX) & "' y2='" & (_boxY + 34) & "' stroke='%230E0E0C' stroke-width='2'/>"
			        & "<rect x='" & (_selX - 9) & "' y='" & (_selY - 9) & "' width='18' height='18' fill='%23FFDE00' stroke='%230E0E0C' stroke-width='3'/>"
			        & "<rect x='" & _boxX & "' y='" & _boxY & "' width='224' height='34' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='2'/>"
			        & "<text x='" & (_boxX + 12) & "' y='" & (_boxY + 23) & "' font-size='15' font-weight='bold' fill='%230E0E0C'>At " & FORMAT(_pe, "0") & "x: EPS " & FORMAT(DIVIDE(_price, _pe), "$0.00") & "</text>"
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: c29a2d62-90f3-41cb-a471-3cb71abdf6d9

	/// The Stack: VALUATION ledger of price, multiples and scenario outputs.
	measure 'SVG Valuation Ledger' =
			VAR _sc = SELECTEDVALUE('Scenario'[Scenario], "Base")
			VAR _pe = [Selected PE]
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='496' viewBox='0 0 400 496' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & "<rect x='0' y='0' width='400' height='3' fill='%230E0E0C'/><rect x='0' y='38' width='54' height='16' fill='%230E0E0C'/><text x='27' y='50' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='26' font-size='15' font-weight='bold' fill='%230E0E0C'>" & "Share price, " & FORMAT([Latest Price Date], "d mmm yyyy") & "</text>"
			        & "<text x='62' y='51' font-size='13' fill='%230E0E0C'>" & "52-week range " & FORMAT([Price 52W Low], "$0") & "-" & FORMAT([Price 52W High], "$0") & "</text>"
			        & "<g fill='%230E0E0C'>" & (
			        VAR _ptvl0 = FORMAT([Latest Price], "$0.00")
			        VAR _pxvl0 = (400 - (LEN(FORMAT([Latest Price], "$0.00")) * 30 - 5))
			        VAR _pyvl0 = 66
			        RETURN
			            CONCATENATEX(
			                GENERATE(
			                    SELECTCOLUMNS(GENERATESERIES(1, LEN(_ptvl0), 1), "civl0", [Value]),
			                    VAR _bits = LOOKUPVALUE('Glyphs'[Bits], 'Glyphs'[Code], UNICODE(MID(_ptvl0, [civl0], 1)), REPT("0", 35))
			                    RETURN FILTER(SELECTCOLUMNS(GENERATESERIES(0, 34, 1), "cellvl0", [Value]), MID(_bits, [cellvl0] + 1, 1) = "1")
			                ),
			                "<rect x='" & (_pxvl0 + ([civl0] - 1) * 30 + MOD([cellvl0], 5) * 5) & "' y='" & (_pyvl0 + INT([cellvl0] / 5) * 5) & "' width='5' height='5'/>",
			                ""
			            )
			    ) & "</g>"
			        & "<rect x='0' y='112' width='400' height='1' fill='%230E0E0C'/><rect x='0' y='146' width='54' height='16' fill='%230E0E0C'/><text x='27' y='158' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='136' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Market cap, diluted" & "</text>"
			        & "<text x='62' y='159' font-size='12' fill='%230E0E0C'>" & "on 269.8M diluted shares" & "</text>"
			        & "<text x='400' y='157' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & "$" & FORMAT([Market Cap Bn], "0.0") & "B" & "</text>"
			        & "<rect x='0' y='188' width='400' height='1' fill='%230E0E0C'/><rect x='0' y='222' width='54' height='16' fill='%230E0E0C'/><text x='27' y='234' text-anchor='middle' font-size='10' font-weight='bold' fill='%23F4F4F0'>ACTUAL</text>"
			        & "<text x='0' y='212' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Trailing P/E" & "</text>"
			        & "<text x='62' y='235' font-size='12' fill='%230E0E0C'>" & "on " & FORMAT([TTM EPS], "$0.00") & " last-four-quarter EPS" & "</text>"
			        & "<text x='400' y='233' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C'>" & FORMAT([Trailing PE], "0.0") & "x" & "</text>"
			        & "<rect x='0' y='264' width='400' height='1' fill='%230E0E0C'/><rect x='250' y='274' width='150' height='56' fill='url(%23g)'/><rect x='0.75' y='298.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='302' width='8' height='8' fill='url(%23s)'/><text x='36' y='310' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<text x='0' y='288' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "FY2026 EPS, " & LOWER(_sc) & " case" & "</text>"
			        & "<text x='68' y='311' font-size='12' fill='%230E0E0C'>" & "net income " & FORMAT([Scenario Net Income Bn], "$0.00") & "B" & "</text>"
			        & "<text x='390' y='309' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C' stroke='%23F4F4F0' stroke-width='7' stroke-linejoin='round' paint-order='stroke'>" & FORMAT([Projected EPS], "$0.00") & "</text>"
			        & "<rect x='0' y='340' width='400' height='1' fill='%230E0E0C'/><rect x='250' y='350' width='150' height='56' fill='url(%23g)'/><rect x='0.75' y='374.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='378' width='8' height='8' fill='url(%23s)'/><text x='36' y='386' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<text x='0' y='364' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Value at " & FORMAT(_pe, "0") & "x" & "</text>"
			        & "<text x='68' y='387' font-size='12' fill='%230E0E0C'>" & SUBSTITUTE(FORMAT([Implied Upside], "+0%;-0%;0%"), "%", "%25") & " vs close" & "</text>"
			        & "<text x='390' y='385' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C' stroke='%23F4F4F0' stroke-width='7' stroke-linejoin='round' paint-order='stroke'>" & FORMAT([Implied Price], "$0") & "</text>"
			        & "<rect x='0' y='416' width='400' height='1' fill='%230E0E0C'/><rect x='250' y='426' width='150' height='56' fill='url(%23g)'/><rect x='0.75' y='450.75' width='58.5' height='14.5' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='1.5'/><rect x='4' y='454' width='8' height='8' fill='url(%23s)'/><text x='36' y='462' text-anchor='middle' font-size='10' font-weight='bold' fill='%230E0E0C'>MODEL</text>"
			        & "<text x='0' y='440' font-size='14' font-weight='bold' fill='%230E0E0C'>" & "Q4 net income needed" & "</text>"
			        & "<text x='68' y='463' font-size='12' fill='%230E0E0C'>" & "after $3.81B through Q3" & "</text>"
			        & "<text x='390' y='461' text-anchor='end' font-size='22' font-weight='bold' fill='%230E0E0C' stroke='%23F4F4F0' stroke-width='7' stroke-linejoin='round' paint-order='stroke'>" & "$" & FORMAT([Q4 Net Income Needed Bn], "0.00") & "B" & "</text>"
			        & "<rect x='0' y='493' width='400' height='2' fill='%230E0E0C'/></svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: 49f08e6d-bc3a-4f02-9f7a-42841368a021

	/// The Stack: test strip of implied value at every P/E step; the transparent P/E slicer sits on top.
	measure 'SVG PE Strip' =
			VAR _sel = [Selected PE]
			VAR _eps = [Projected EPS]
			VAR _steps = ADDCOLUMNS(ALL('PE Multiple'[P/E Multiple]), "@i", RANKX(ALL('PE Multiple'[P/E Multiple]), 'PE Multiple'[P/E Multiple], , ASC) - 1)
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='1036' height='80' viewBox='0 0 1036 80' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'><defs><pattern id='d' width='4' height='4' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='2' y='2' width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='s' width='6' height='6' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/></pattern><pattern id='g' width='8' height='8' patternUnits='userSpaceOnUse'><rect width='2' height='2' fill='%230E0E0C'/><rect x='4' y='4' width='2' height='2' fill='%230E0E0C'/></pattern></defs>"
			        & CONCATENATEX(
			            _steps,
			            VAR _x = ROUND([@i] * 94.7, 1)
			            VAR _on = 'PE Multiple'[P/E Multiple] = _sel
			            VAR _ink = IF(_on, "%23F4F4F0", "%230E0E0C")
			            RETURN
			                "<rect x='" & (_x + 1.5) & "' y='1.5' width='85.7' height='77' fill='" & IF(_on, "%230E0E0C", "%23F4F4F0") & "' stroke='%230E0E0C' stroke-width='3'/>"
			                    & IF(_on, "", "<rect x='" & (_x + 8) & "' y='60' width='72' height='12' fill='url(%23s)'/>")
			                    & "<text x='" & (_x + 44.4) & "' y='28' text-anchor='middle' font-size='17' font-weight='bold' fill='" & _ink & "'>" & FORMAT('PE Multiple'[P/E Multiple], "0") & "x</text>"
			                    & "<text x='" & (_x + 44.4) & "' y='52' text-anchor='middle' font-size='14' fill='" & _ink & "'>" & FORMAT('PE Multiple'[P/E Multiple] * _eps, "$0") & "</text>",
			            "",
			            'PE Multiple'[P/E Multiple], ASC
			        )
			        & "</svg>"
		dataCategory: ImageUrl
		displayFolder: The Stack
		lineageTag: fc19102b-68af-4d90-bc9b-2cc08cb68da4

	/// The Stack: painted Bear, Base and Bull keys; the transparent Scenario slicer sits on top.
	measure 'SVG Scenario Keys' =
			VAR _sel = SELECTEDVALUE('Scenario'[Scenario], "Base")
			RETURN
			    "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='372' height='64' viewBox='0 0 372 64' shape-rendering='crispEdges' font-family='Verdana,Geneva,sans-serif'>"
			        & IF(_sel = "Bear",
			            "<rect x='5.5' y='5.5' width='109' height='53' rx='12' fill='%230E0E0C' stroke='%230E0E0C' stroke-width='3'/><text x='60' y='38' text-anchor='middle' font-size='17' font-weight='bold' fill='%23F4F4F0'>Bear</text>",
			            "<rect x='5.5' y='5.5' width='109' height='53' rx='12' fill='%230E0E0C' stroke='%230E0E0C' stroke-width='3'/><rect x='1.5' y='1.5' width='109' height='53' rx='12' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='3'/><text x='56' y='34' text-anchor='middle' font-size='17' font-weight='bold' fill='%230E0E0C'>Bear</text>")
			        & IF(_sel = "Base",
			            "<rect x='129.5' y='5.5' width='109' height='53' rx='12' fill='%230E0E0C' stroke='%230E0E0C' stroke-width='3'/><text x='184' y='38' text-anchor='middle' font-size='17' font-weight='bold' fill='%23F4F4F0'>Base</text>",
			            "<rect x='129.5' y='5.5' width='109' height='53' rx='12' fill='%230E0E0C' stroke='%230E0E0C' stroke-width='3'/><rect x='125.5' y='1.5' width='109' height='53' rx='12' fill='%23F4F4F0' stroke='%230E0E0C' stroke-width='3'/><text x='180' y='34' text-anchor='middle' font-size='17' font-weight='bold' fill='%230E0E0C'>Base</text>")
			        & IF(_sel = "Bull",
